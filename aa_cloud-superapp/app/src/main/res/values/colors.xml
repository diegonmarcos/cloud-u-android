<?xml version="1.0" encoding="utf-8"?>
<!-- Tile palette — 8 pastel/strong colour pairs rotated through the grid
     so each tile gets a unique colour (Google-Drive-style). The hash of
     the tile id is used to pick a slot, so the same tile keeps the same
     colour across launches. -->
<resources>
    <color name="tile_blue_bg">#FFE3F2FD</color>
    <color name="tile_blue_fg">#FF1565C0</color>

    <color name="tile_green_bg">#FFE8F5E9</color>
    <color name="tile_green_fg">#FF2E7D32</color>

    <color name="tile_purple_bg">#FFEDE7F6</color>
    <color name="tile_purple_fg">#FF6A1B9A</color>

    <color name="tile_pink_bg">#FFFCE4EC</color>
    <color name="tile_pink_fg">#FFC2185B</color>

    <color name="tile_orange_bg">#FFFFF3E0</color>
    <color name="tile_orange_fg">#FFEF6C00</color>

    <color name="tile_teal_bg">#FFE0F2F1</color>
    <color name="tile_teal_fg">#FF00695C</color>

    <color name="tile_amber_bg">#FFFFF8E1</color>
    <color name="tile_amber_fg">#FFB28704</color>

    <color name="tile_indigo_bg">#FFE8EAF6</color>
    <color name="tile_indigo_fg">#FF283593</color>

    <!-- ── Cloud SuperApp brand palette (M3) ────────────────────────── -->
    <!-- Seed = cloud-blue #1565C0. Derived light & dark tokens. -->
    <color name="cloud_primary">#FF1565C0</color>
    <color name="cloud_on_primary">#FFFFFFFF</color>
    <color name="cloud_primary_container">#FFD0E4FF</color>
    <color name="cloud_on_primary_container">#FF001D36</color>
    <color name="cloud_secondary">#FF535F70</color>
    <color name="cloud_secondary_container">#FFD7E3F7</color>
    <color name="cloud_on_secondary_container">#FF101C2B</color>
    <color name="cloud_tertiary">#FF6B5778</color>
    <color name="cloud_tertiary_container">#FFF3DAFF</color>

    <!-- Status / navigation bars stay transparent for the edge-to-edge
         layout enabled by WindowCompat in MainActivity.onCreate. -->

    <!-- ── Island chrome (opaque black, over black→purple gradient) ── -->
    <!-- User palette: top + bottom islands are fully black; the
         background behind them is a black→deep-purple linear gradient
         (see drawable/bg_gradient_black_purple.xml). Border is a faint
         purple-tinted white so the island edge reads against pure black. -->
    <color name="glass_bg">#FF000000</color>            <!-- island surface — opaque black -->
    <color name="glass_border">#33A78BFA</color>        <!-- faint purple-violet hairline -->
    <color name="glass_bg_dark">#FF000000</color>
    <color name="glass_border_dark">#33A78BFA</color>
    <!-- Accent on-island text / icon — bright violet matches the gradient hue. -->
    <color name="island_accent">#FFB794F4</color>

    <!-- ── Drawer header surfaces ───────────────────────────────────── -->
    <!-- M3 colorPrimaryContainer / colorSecondaryContainer defaults on
         Material3.DayNight read as light blue / pale purple — neither
         matches the app's own black→deep-purple body gradient. These
         drawer-specific tokens replace those defaults so the App + User
         banners share the same visual family as the body. -->
    <color name="drawer_banner_app">#FF1A0033</color>     <!-- deep violet/black -->
    <color name="drawer_banner_user">#FF0E0220</color>    <!-- one shade darker, still violet-tinted -->
    <color name="drawer_banner_text">#FFE9D8FD</color>    <!-- same lavender used on island accents -->
    <color name="drawer_avatar">#FF7C3AED</color>         <!-- vibrant violet — matches fan-menu highlight -->
    <color name="drawer_separator">#55B794F4</color>      <!-- faint violet hairline -->

    <!-- ── Status light (Configs ▸ Panel ▸ Control, Permissions, Profile) ──
         The app's ONE definition of healthy / failed / cannot-say. They are
         resources and not Kotlin constants so a theme can override them: this
         app paints its pages over a black→deep-purple gradient by default and
         over PURE BLACK under the two oled_black launcher themes, and a status
         light is the last thing on screen that may become hard to read.

         Chosen against BOTH of those surfaces, not against white. The values
         these replaced (#16A34A / #DC2626 / #6B7280) were picked for a light
         background and measured 4.35:1 and 2.95:1 for the red on black and on
         the purple band — below the 4.5:1 AA floor for the 12sp text they are
         drawn as. test-configs-panel-control.sh recomputes every ratio rather
         than trusting this comment. -->
    <color name="status_light_on">#FF3DDC84</color>       <!-- 11.77:1 black, 7.99:1 purple -->
    <color name="status_light_off">#FFF87171</color>      <!--  7.59:1 black, 5.16:1 purple -->
    <color name="status_light_unknown">#FFB0B8C4</color>  <!-- 10.50:1 black, 7.13:1 purple -->

    <!-- ── Configs ▸ Panel ▸ Control chrome ─────────────────────────────
         The row label, its note, the group heading and the sentence naming a
         missing grant. Here rather than as Kotlin constants for the same
         reason as the lights above: a colour compiled into the fragment
         cannot follow a theme. -->
    <color name="control_label">#FFFFFFFF</color>
    <color name="control_note">#AAFFFFFF</color>
    <color name="control_section">#FF8BE9A0</color>
    <color name="control_blocked">#FFFFB199</color>
</resources>
