<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud SuperApp theme. Material 3 DayNight (auto light/dark from system)
     extended with the brand palette in colors.xml. DynamicColors (Android
     12+) is applied at runtime in App.onCreate so phones with system
     wallpaper colours get a personalised override; older devices fall
     back to the static brand colours declared here. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Superapp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colour tokens (M3). -->
        <item name="colorPrimary">@color/cloud_primary</item>
        <item name="colorOnPrimary">@color/cloud_on_primary</item>
        <item name="colorPrimaryContainer">@color/cloud_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/cloud_on_primary_container</item>
        <item name="colorSecondary">@color/cloud_secondary</item>
        <item name="colorSecondaryContainer">@color/cloud_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/cloud_on_secondary_container</item>
        <item name="colorTertiary">@color/cloud_tertiary</item>
        <item name="colorTertiaryContainer">@color/cloud_tertiary_container</item>

        <!-- Black → deep-purple gradient backdrop. Applied at window level
             so it shows through any transparent fragment area; the
             CoordinatorLayout also sets it explicitly to cover its
             children that render their own backgrounds. -->
        <item name="android:windowBackground">@drawable/bg_gradient_black_purple</item>
        <item name="android:colorBackground">#FF000000</item>

        <!-- Edge-to-edge: transparent system bars, content draws beneath
             them. MainActivity applies WindowInsets to keep the toolbar +
             bottom-nav from underlapping cutouts / nav gestures. Status &
             nav icons forced to LIGHT (white) so they read against the
             dark gradient. -->
        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="lollipop">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- Tooltip frame — fully transparent. android:tooltipFrameBackground
             is `@hide` so AAPT2 rejects `android:` prefix; the `*android:`
             escape hatch tells AAPT2 to allow setting private framework
             attrs (this is the same mechanism AppCompat itself uses for
             a number of `@hide` system attrs). If your device honours the
             framework attr the system long-press tooltip pill paints
             transparent — invisible. If it's an OEM override (Samsung
             One UI in particular), this is a no-op and the pill stays
             coloured; we still attach a long-click consumer in
             MainActivity.installTooltipConsumer as fallback. -->
        <item name="*android:tooltipFrameBackground">@drawable/bg_tooltip_transparent</item>
    </style>

    <!-- The bottom nav is libs:bottomnav's Compose island (#531). No Material navigation
         classes and no themed style: ShellBottomNav carries this theme's colorSurfaceInverse /
         colorOnSurfaceInverse / colorOnSurfaceVariant into the island's pill and ink. -->

    <!-- Custom dense text style for drawer rows. The default
         textAppearanceBodyMedium has ~20sp lineHeight which dominates
         the row height regardless of itemMinHeight. Override with
         12sp text + 14sp lineHeight + 0 padding so the row collapses
         to the smallest readable height. -->
    <style name="TextAppearance.CloudSuperApp.DrawerDense" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">14sp</item>
        <item name="lineHeight">14sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Heading over one section of a page that has several (Drive's Apps
         and Configs). Matches the group headers GroupedTilesFragment draws
         in code so a section heading reads the same wherever it appears. -->
    <style name="DriveSectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <!--
      ── One Material3 style PER MODE ───────────────────────────────────────
      The owner, on the Power Saving mode: "it does draw the black screen but
      is not full screen; and submenus still same style as default".

      Both halves of that are this file's fault, not the fragment's.
      LauncherPalette themes only the views this app DRAWS in Kotlin. The 24
      XML layouts resolve 82 `?attr/` references through whatever Material3
      style the Activity was created with — and there was exactly one, with
      the purple gradient hard-wired as android:windowBackground. So a mode
      could repaint its own home screen and still hand every submenu, dialog
      and spinner back to the default look, and the window UNDER the black
      fragment stayed purple, which is the "not full screen" the owner saw at
      every inset and over-scroll edge.

      A mode now names its own style in build.json (`ui.launcher_themes[*]
      .style`), ShellActivity applies it in onCreate before setContentView,
      and a mode switch recreates the Activity so the new style takes. That
      makes the mode's look reach every XML surface in the app, for free,
      without touching any of the 24 layouts.
    -->

    <!-- Cloud Minimalist Black. Pure black ground, terminal-green ink. -->
    <style name="Theme.Superapp.MinimalistBlack" parent="Theme.Superapp">
        <item name="android:windowBackground">@color/theme_terminal_window</item>
        <item name="android:colorBackground">@color/theme_terminal_window</item>
        <item name="colorPrimary">@color/theme_terminal_accent</item>
        <item name="colorOnPrimary">@color/theme_terminal_window</item>
        <item name="colorPrimaryContainer">@color/theme_terminal_window</item>
        <item name="colorOnPrimaryContainer">@color/theme_terminal_text_primary</item>
        <item name="colorSecondary">@color/theme_terminal_text_secondary</item>
        <item name="colorOnSecondary">@color/theme_terminal_window</item>
        <item name="colorSecondaryContainer">@color/theme_terminal_window</item>
        <item name="colorOnSecondaryContainer">@color/theme_terminal_text_primary</item>
        <item name="colorSurface">@color/theme_terminal_window</item>
        <item name="colorOnSurface">@color/theme_terminal_text_primary</item>
        <item name="colorSurfaceVariant">@color/theme_terminal_window</item>
        <item name="colorOnSurfaceVariant">@color/theme_terminal_text_secondary</item>
        <item name="colorOutline">@color/theme_terminal_hairline</item>
        <item name="colorOutlineVariant">@color/theme_terminal_hairline</item>
        <item name="android:textColorPrimary">@color/theme_terminal_text_primary</item>
        <item name="android:textColorSecondary">@color/theme_terminal_text_secondary</item>
        <item name="android:textColorTertiary">@color/theme_terminal_text_secondary</item>
        <item name="android:textColorHint">@color/theme_terminal_text_secondary</item>
        <item name="android:colorEdgeEffect">@color/theme_terminal_accent</item>
    </style>

</resources>
