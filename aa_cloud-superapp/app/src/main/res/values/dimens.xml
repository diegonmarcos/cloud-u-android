<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own spacing tokens. One declaration each, never a literal copied into a layout or
     style (the rule #380/#381/#384/#408/#424 closed).

     NO bottom_nav_* token lives here any more (#531). The bottom nav is libs:bottomnav's island
     and its geometry is declared once, in that module's res/values/dimens.xml. A same-named
     dimen here would silently OVERRIDE the library's at resource merge, which is a second
     declaration of every number #462/#473/#477/#498 settled. BottomNavGeometryTest reads the
     library's tokens back and fails if the rendered island disagrees with them. -->

<resources>
    <!-- #477. The tab-strip's OWN top breathing room above the toolbar island
         the app draws INTO the camera cutout. This is a base only: the real
         clearance is added at runtime from the status-bar / display-cutout
         inset (SectionTabsFragment reads it through an insets listener and
         sets the strip's top margin to base + inset), because a fixed dp is
         right at one cutout geometry and wrong at every other — the #407 rule
         the launcher clock already follows. Declared here once so the base is
         a single knob, never a literal in the code. -->
    <dimen name="tab_strip_top_inset">10dp</dimen>
</resources>