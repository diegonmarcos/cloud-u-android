<?xml version="1.0" encoding="utf-8"?>
<!-- Shell = FrameLayout. Three children, each with explicit gravity:
     - FragmentContainerView (background) MATCH_PARENT with paddings
       accommodating both islands' heights so content doesn't slide
       under them.
     - AppBarLayout (top island)        layout_gravity=top
     - bottom_nav_island MaterialCardView (bottom island) gravity=bottom

     Why FrameLayout: LinearLayout's weight calculation kept producing
     regressions where the bottom island vanished. FrameLayout positions
     children at explicit anchors with NO inter-child sizing math. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <FrameLayout
        android:id="@+id/shell_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_black_purple"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Galaxy backdrop — promoted to the shell level so the stars +
             comets fill the WHOLE screen edge-to-edge, including the
             status-bar area where the camera punch-hole + system icons
             live. On non-home pages most fragments overlay opaque
             content so the galaxy only peeks through transparent zones
             (the system bars, fragment-transition fade, etc.). -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/galaxy_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!-- Content host — responsive. Phone (default): a single
             full-bleed @id/fragment_container. Tablet (sw600dp): a
             master (@id/fragment_container) + detail (@id/detail_container)
             split. See res/layout[-sw600dp]/view_content_panes.xml. The
             chrome below (islands, sirius star, drawer) is shared by BOTH
             form factors — only the content host swaps. -->
        <include layout="@layout/view_content_panes" />

        <!-- Full-bleed modal overlay host. Notification Center, Search and
             the update overlay are added here (not into the content host)
             so they ALWAYS span the full screen width — on tablets they
             cover both master + detail panes instead of being trapped in
             the 40% master column. Same island paddings as the content
             host so they stay clear of the top/bottom islands exactly as
             before; empty + non-clickable → touch-transparent to the
             content underneath until an overlay is added. -->
        <FrameLayout
            android:id="@+id/overlay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="84dp"
            android:paddingBottom="92dp"
            android:clipToPadding="false"
            android:clickable="false"
            android:focusable="false" />

        <!-- Sirius Star — a single bright, bluish-white sparkle centred on the
             home screen (theme-agnostic: it floats over whichever home
             fragment is active). A tap opens the CircularMenu — the ALL-APPS
             radial pie (build.json::onehand.circular_menu). Slightly
             larger than the home tiles + a soft glow (shadowLayer) for the
             "shining" look; MainActivity adds a gentle pulse and flips it
             VISIBLE only on the `home` section. Default gone. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/all_apps_sirius_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Sirius Star — all apps"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:visibility="gone" />

        <!-- Canopus star — the 2nd-brightest. Sits UNDER the cube (translationY
             set in code), a touch bigger than Sirius. Tapping it opens the
             libs:launcher-onehand ArcMenu on the CONFIGS section
             (build.json::onehand.arc_menu). Glyph/size data-driven from
             build.json::onehand.circular_menu.star. VISIBLE only on `home`. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/configs_canopus_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Canopus Star — configs"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:visibility="gone" />

        <!-- Centauri star — the 3rd star (libs:launcher-onehand CentaurusStar), sitting
             EXACTLY between Sirius (screen centre) and Canopus (near the
             bottom-nav island) — translationY = half of Canopus's own
             island-anchored offset, set in code. Opens the SAME arc-menu as
             Canopus, but content = last 9 recently-opened Android apps
             (AppUsageProvider), not a build.json section. VISIBLE only on
             `home`. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/active_apps_centauri_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/star_centauri_desc"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:visibility="gone" />

        <!-- Recent Tabs star — the 4th star, and Centauri's twin: same midway
             row, mirrored to the RIGHT of the centre line by the same
             build.json::onehand.circular_menu.star.pair_offset_x_dp that pushes
             Centauri left. Built from the generic host-driven arc star
             (libs:launcher-onehand CanopusStar) because its CONTENT is
             app-specific: the last pages opened inside this app, read from the
             App Tabs LRU. Deliberately NOT the last Android apps — that is
             Centauri, to its left. VISIBLE only on `home`. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/recent_tabs_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/star_recent_tabs_desc"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:visibility="gone" />

        <!-- Polaris star — the 5th star and the only one at the TOP of the
             screen (libs:launcher-onehand PolarisStar). Opens the SuperApp's
             own search sheet on a tap; it has no menu, because every menu in
             that package fans upward and would draw off the top edge from
             here. layout_gravity is top, and the exact distance down comes
             from build.json::onehand.search_star.top_offset_dp so the star
             clears the toolbar island by declaration rather than by a margin
             typed in twice. VISIBLE only on `home`, like its four siblings. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/search_polaris_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:contentDescription="@string/star_search_desc"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:visibility="gone" />

        <!-- Launcher status strip — visible ONLY when the SuperApp is
             the default Android launcher AND the active LauncherTheme
             is Cloud. Drawn at the very top edge (where the system
             status bar used to live before MainActivity hid it).
             Default visibility is gone; MainActivity.applyLauncherChrome
             flips it on per the (isLauncher, theme) state. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/launcher_status_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:elevation="20dp"
            android:visibility="gone" />

        <!-- Top island — FrameLayout with the bg_liquid_glass rounded
             drawable as background. MaterialCardView was producing
             measure-cycle bugs with match_parent children (View +
             ShimmerBorderView) inside a wrap_content card; the card
             would inflate to the full screen and the shimmer would
             draw around the entire viewport. FrameLayout with a
             rounded drawable bg avoids all that — wrap_content
             collapses to its single intrinsic-sized child
             (the toolbar ComposeView at ?attr/actionBarSize). -->
        <FrameLayout
            android:id="@+id/toolbar_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="26dp">

            <!-- The top row: hamburger (left) and Back (right) off the Home root, drawn in Compose (ui/ShellToolbar.kt).
                 A transparent ComposeView at the old action-bar height; it carries no title. -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize" />

            <!-- Revolut-style corner orbs — Home root ONLY. At the root the
                 full-width glass bar dissolves (ShellActivity nulls the
                 island background and the toolbar hamburger) and these two
                 detached liquid-glass circles carry the same two actions the
                 toolbar carried: left opens the MAIN MENU (drawer), right
                 launches the wallet's home app. The right orb's target is
                 DECLARED in build.json::ui.top_orbs (baked as
                 UI_TOP_ORBS_B64), never hardcoded — the wallet deck moved
                 into Cloud-Me, so the declaration points there today and a
                 future move is a JSON edit. Off the Home root both orbs hide
                 and the classic toolbar returns (hamburger | island | back). -->
            <FrameLayout
                android:id="@+id/main_menu_orb"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/main_menu_open"
                android:visibility="gone">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/main_menu_orb_glyph"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/top_wallet_orb"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/action_wallet"
                android:visibility="gone">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/top_wallet_orb_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- Music-playing mini-island: a ComposeView (media/MusicIslandUi.kt), the small black pill above the main
                 Dynamic Island that shows the playing app's icon, a scrolling title and a thin wave while a media session
                 is PLAYING. MusicIslandController sets its content on first resume; tap opens the controls popup. -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/music_playing_island"
                android:layout_width="90dp"
                android:layout_height="16dp"
                android:layout_gravity="top|center_horizontal"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <!-- Apple-style centered "Dynamic Island" pill. Anchored to the
                 toolbar center via gravity; lives between the hamburger
                 (left, drawer toggle) and the action items (right, Back).
                 Half the width / height of where the old search trigger
                 sat — pure decoration for now, but with a stable id so
                 future status surfaces (sync state, notifications, etc.)
                 can swap into it. -->
            <FrameLayout
                android:id="@+id/dynamic_island"
                android:layout_width="120dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dynamic_island"
                android:clickable="false"
                android:focusable="false">

                <!-- IslandWaveView replaces the old "DCM · Apps"
                     identity text — a Samsung-music-island-style
                     animated triple-sine wave in violet→lilac gradient.
                     The id stays `dynamic_island_label` so the existing
                     refreshDynamicIsland's findViewById<TextView>
                     short-circuits gracefully (returns null → early
                     return) without any code change. -->
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/dynamic_island_wave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Prismatic neon halo around the island perimeter —
                     full rainbow sweep chasing around the pill. Sized
                     match_parent so it covers the island exactly.
                     clickable=false so taps pass through to the parent
                     island FrameLayout's notification-center handler. -->
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/dynamic_island_prism"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

        </FrameLayout>

        <!-- Bottom island (#531): libs:bottomnav's Compose island, the fleet's ONE bottom nav.
             The island draws its own pill, width (80%), end insets and bottom clearance from
             the lib's dimens, so this tag carries no geometry of its own. ShellBottomNav feeds
             it build.json::ui.bottom_nav. It keeps the id every anchor (stars, chrome) uses. -->
        <com.diegonmarcos.superapp.bottomnav.BottomNavIslandView
            android:id="@+id/bottom_nav_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />
    </FrameLayout>

    <include layout="@layout/view_drawer_panel" />

</androidx.drawerlayout.widget.DrawerLayout>
