<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer panel — 2-tier navigation:
       Row 1  Top tabs:        [Home]  [<currentSection>]
       Below  Content:         FragmentContainerView, swaps per page tap
     Width fixed to 280dp so long account/folder names don't blow up the
     drawer. Per the user model: each FOSS app exposes its own page set
     via build.json::ui.sections[X].pages[]. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_panel"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/bg_drawer_glass"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Row 1 — [Home] [<currentSection>]: libs:bottomnav's pill strip (#868). -->
    <com.diegonmarcos.superapp.bottomnav.PageTabsView
        android:id="@+id/drawer_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/drawer_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
