<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom nav island. Deliberately NOT bg_liquid_glass: this bar is meant to
     read as a solid box, so it is a flat opaque fill plus a hairline edge and
     nothing else. The glass sheen bg_liquid_glass paints on top is what made
     the top of the bar still look see-through after the base went opaque —
     a 25%-white gradient over the fill is still a glassy band. It is gone.
     bg_liquid_glass itself is untouched: the top island, the search sheet,
     the app drawer and the notification centre are all meant to stay glass.

     Full pill (semicircular ends), not a rounded box: the radius token is
     larger than half the bar height on any build, so the framework clamps it
     to height/2 and each end is a perfect semicircle — the same convention
     bg_dynamic_island and bg_liquid_glass_pill use. The radius is the SAME
     token the selected-item capsule references (values/dimens.xml), so the
     container and the item share one declaration and can never drift apart.
     The bar's content (BottomNavigationView) is inset by the island margins
     plus the navigation's own internal padding, so the deeper corner round
     never clips an item. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Opaque fill. Darker than the #2D1B69 the window gradient ends on, so
         the bar reads as a solid box sitting on the page. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/bottom_nav_pill_corner_radius" />
            <solid android:color="#FF140B26" />
        </shape>
    </item>
    <!-- Hairline edge so the box still has a defined boundary. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/bottom_nav_pill_corner_radius" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
