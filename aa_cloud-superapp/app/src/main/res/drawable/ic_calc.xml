<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Calc's glyph for the Cloud > Tools Primary Calc tile (#772): a body, a
  display and a 3x3 key grid.

  SOURCE: ac_cloud-calc/app/src/main/res/drawable/ic_launcher_foreground.xml.
  The pathData is copied verbatim (test-calc-icon.sh fails if it drifts); only
  the box changed, as in ic_writer: the 108-unit adaptive viewport is cropped
  to 56 and the group translate re-centres the art (x 34..74, y 28..80).

  The tile tints every glyph flat on bind (GroupedTilesFragment.tileCell), so
  only the shape reaches the screen. That is why the display and the keys are
  HOLES in the body (evenOdd) and not dark fills on top of it: dark fills
  flatten into the body and the tile reads as a plain rectangle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="56"
    android:viewportHeight="56">

    <group android:translateX="-26" android:translateY="-26">
        <path
            android:fillColor="#FFB794F4"
            android:fillType="evenOdd"
            android:pathData="M38,28h32a4,4 0,0 1,4 4v44a4,4 0,0 1,-4 4h-32a4,4 0,0 1,-4 -4v-44a4,4 0,0 1,4 -4zM40,33h28v10h-28zM40,48h7v7h-7zM50.5,48h7v7h-7zM61,48h7v7h-7zM40,58.5h7v7h-7zM50.5,58.5h7v7h-7zM61,58.5h7v7h-7zM40,69h7v7h-7zM50.5,69h7v7h-7zM61,69h7v7h-7z" />
    </group>
</vector>
