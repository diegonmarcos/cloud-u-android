<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud Dialer interface refresh: a Material 3 surface-container card. Same
     fill as the recents rows so the Home page and the call history read as one
     surface family, with the larger corner radius Material 3 gives a card that
     holds a whole section rather than a single row. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container" />
    <corners android:radius="@dimen/home_card_corner_radius" />
</shape>
