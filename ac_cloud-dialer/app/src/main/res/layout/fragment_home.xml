<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud Dialer: the Home page — the owner's calling life at a glance, and the
    page the app opens on.

    Cards are ordered by how prominent the owner asked each answer to be: what
    happened just now, what he missed, how much of his life the phone took this
    month, who took it, and the shape of it all.

    Every number here comes from android.provider.CallLog.Calls and nothing
    else. Where the provider stores no answer there is no card and no
    placeholder — see CallStatsHelper for what it will and will not give up.
-->
<org.fossify.phone.fragments.HomeFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/recyclerview_fab_padding"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Recent calls -->
            <LinearLayout style="@style/HomeCard">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/home_recent_calls_title"
                        style="@style/HomeCardTitle"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/home_recent_calls" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/home_see_all_calls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="@dimen/minimum_touch_target"
                        android:minHeight="@dimen/minimum_touch_target"
                        android:gravity="center"
                        android:paddingStart="@dimen/normal_margin"
                        android:paddingEnd="@dimen/normal_margin"
                        android:text="@string/home_see_all"
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold" />

                </RelativeLayout>

                <org.fossify.commons.views.MyRecyclerView
                    android:id="@+id/home_recent_calls_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"
                    app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

            </LinearLayout>

            <!-- Missed calls: its own number, never a colour buried in a list -->
            <LinearLayout
                android:id="@+id/home_missed_card"
                style="@style/HomeCard"
                android:background="@drawable/home_card_background"
                android:clickable="true"
                android:focusable="true">

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_missed_calls" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/home_missed_count"
                        style="@style/HomeStatValue"
                        tools:text="7" />

                    <org.fossify.commons.views.MyTextView
                        style="@style/HomeStatLabel"
                        android:layout_marginStart="@dimen/small_margin"
                        android:text="@string/home_missed_this_month" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/home_missed_in_window"
                    style="@style/HomeStatLabel"
                    android:layout_marginTop="@dimen/tiny_margin"
                    tools:text="41 in the last 12 months" />

            </LinearLayout>

            <!-- Time on calls, by real calendar month -->
            <LinearLayout style="@style/HomeCard">

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_time_on_calls" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/home_talk_time_this_month"
                        style="@style/HomeStatValue"
                        tools:text="4h 12m" />

                    <org.fossify.commons.views.MyTextView
                        style="@style/HomeStatLabel"
                        android:layout_marginStart="@dimen/small_margin"
                        android:text="@string/home_this_month" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/home_talk_time_trend"
                    style="@style/HomeStatLabel"
                    android:layout_marginTop="@dimen/tiny_margin"
                    tools:text="38m more than last month" />

                <LinearLayout
                    android:id="@+id/home_month_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/home_talk_time_total"
                    style="@style/HomeStatLabel"
                    android:layout_marginTop="@dimen/small_margin"
                    tools:text="58h 20m in the last 12 months" />

            </LinearLayout>

            <!-- Who he actually talks to -->
            <LinearLayout
                android:id="@+id/home_top_contacts_card"
                style="@style/HomeCard">

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_top_contacts" />

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeStatLabel"
                    android:layout_marginTop="@dimen/small_margin"
                    android:text="@string/home_by_talk_time" />

                <LinearLayout
                    android:id="@+id/home_top_by_talk_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeStatLabel"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:text="@string/home_by_call_count" />

                <LinearLayout
                    android:id="@+id/home_top_by_call_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- The shape of it -->
            <LinearLayout style="@style/HomeCard">

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_call_mix" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/home_incoming_count"
                            style="@style/HomeStatValue"
                            android:textSize="@dimen/text_headline_small"
                            tools:text="312" />

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/home_incoming_label"
                            style="@style/HomeStatLabel"
                            android:text="@string/home_incoming" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/home_outgoing_count"
                            style="@style/HomeStatValue"
                            android:textSize="@dimen/text_headline_small"
                            tools:text="288" />

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/home_outgoing_label"
                            style="@style/HomeStatLabel"
                            android:text="@string/home_outgoing" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/home_missed_mix_count"
                            style="@style/HomeStatValue"
                            android:textSize="@dimen/text_headline_small"
                            tools:text="41" />

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/home_missed_mix_label"
                            style="@style/HomeStatLabel"
                            android:text="@string/home_missed" />

                    </LinearLayout>

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/home_other_calls"
                    style="@style/HomeStatLabel"
                    android:layout_marginTop="@dimen/small_margin"
                    android:visibility="gone"
                    tools:text="3 rejected, blocked or voicemail calls"
                    tools:visibility="visible" />

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeCardTitle"
                    android:layout_marginTop="@dimen/bigger_margin"
                    android:text="@string/home_average_call" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/home_average_call"
                    style="@style/HomeStatValue"
                    android:layout_marginTop="@dimen/small_margin"
                    android:textSize="@dimen/text_headline_small"
                    tools:text="6m 12s" />

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeStatLabel"
                    android:layout_marginTop="@dimen/tiny_margin"
                    android:text="@string/home_average_call_note" />

                <org.fossify.commons.views.MyTextView
                    style="@style/HomeCardTitle"
                    android:layout_marginTop="@dimen/bigger_margin"
                    android:text="@string/home_time_of_day" />

                <LinearLayout
                    android:id="@+id/home_hour_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/home_busiest_hour"
                    style="@style/HomeStatLabel"
                    android:layout_marginTop="@dimen/small_margin"
                    tools:text="Busiest around 21:00" />

            </LinearLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/home_window_caption"
                style="@style/HomeStatLabel"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/normal_margin"
                android:gravity="center"
                android:textSize="@dimen/small_text_size"
                tools:text="Last 12 months" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!--
        The two states that are nobody's fault: no call history permission, and
        a call history with nothing in it yet. Both say what is missing and, when
        there is something to do about it, offer to do it.
    -->
    <LinearLayout
        android:id="@+id/home_placeholder_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/activity_margin"
        android:visibility="gone">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/home_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:gravity="center"
            android:text="@string/home_no_statistics"
            android:textSize="@dimen/bigger_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/home_placeholder_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:background="@drawable/ripple_all_corners"
            android:gravity="center"
            android:minWidth="@dimen/minimum_touch_target"
            android:minHeight="@dimen/minimum_touch_target"
            android:padding="@dimen/activity_margin"
            android:text="@string/request_access"
            android:textSize="@dimen/bigger_text_size"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/home_progress_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        app:trackCornerRadius="@dimen/small_margin" />

</org.fossify.phone.fragments.HomeFragment>
