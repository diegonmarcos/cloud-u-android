<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ripple_foreground">#33FFFFFF</color>
    <color name="color_missed_call">@color/md_red_500_dark</color>
    <color name="color_outgoing_call">@color/md_green_600</color>
    <color name="color_incoming_call">@color/md_blue_600</color>

    <!-- Cloud Dialer redesign: spam gets its own danger palette, distinct from
         color_missed_call — Truecaller's own color legend reserves red exclusively
         for spam, never a lesser/unrelated state (research-grounded, patch 0015). -->
    <color name="spam_danger_red">#C4281C</color>
    <color name="spam_danger_on_red">#FFFFFF</color>
    <color name="spam_danger_surface">#FBE9E7</color>

    <!-- Cloud Dialer interface refresh: the Material 3 surface-container roles,
         hand-authored because this app is a View fork and does not carry the
         Material 3 dynamic colour role system. Every raised thing in the app —
         a recents row, a Home card, a chart bar — is painted from these three
         and from nothing else, which is what stops the surfaces drifting apart
         the way the app's did before.

         Everything else on screen (text, accents, backgrounds) still comes from
         the owner's chosen theme through commons' getProper*Color, so these
         must stay neutral enough to sit under any accent. -->
    <color name="surface_container">#F2F0F4</color>
    <color name="surface_container_high">#ECE9F0</color>
    <color name="outline_variant">#CAC4D0</color>

    <!-- Kept as the name the recents card drawable was written against, now an
         alias so there is one surface value rather than two that can disagree. -->
    <color name="call_surface_container">@color/surface_container</color>
</resources>
