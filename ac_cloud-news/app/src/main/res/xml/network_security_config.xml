<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration.

  WHY: news-gdelt (aa_cloud-superapp/data/cloud_services.json, port
  3019) is a mesh-internal-only service — its public_url is null. It
  is only reachable at http://news-gdelt:3019 over the WireGuard mesh
  (the hostname resolves via the mesh's own internal DNS — see
  hickory-dns/unbound-dns64 in cloud_services.json and the peer list
  in aa_cloud-superapp/data/mesh.json). It has no public TLS
  certificate, so it can only ever be reached over plain HTTP.
  targetSdk 35 blocks cleartext HTTP by default; without this file a
  user who points NewsBridge.setConfig's `base` at the mesh host would
  get net::ERR_CLEARTEXT_NOT_PERMITTED instead of a working request.

  The base-config keeps cleartextTrafficPermitted="false" (HTTPS-only)
  for everything else, INCLUDING the app's default/public API base
  (the declared public URL of the news service). Only the
  one mesh hostname below is exempted — this file must NOT set
  android:usesCleartextTraffic="true" app-wide in the manifest.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- BEGIN fleet-mesh-cleartext (generated from ac_cloud-account/build.json::fleet_endpoints by 1_cicd/src/scripts/cloud-android-fleet-nsc.py; do not edit) -->
        <domain includeSubdomains="false">git-proxy-api.app</domain>
        <domain includeSubdomains="false">news-gdelt.app</domain>
        <!-- END fleet-mesh-cleartext -->
        <!-- #1093 the mesh host of the declared news service (news-gdelt.app, WireGuard-only, WG encrypts) is GENERATED (above)
             from ac_cloud-account/build.json::fleet_endpoints by 1_cicd/src/scripts/cloud-android-fleet-nsc.py; never hand-listed. -->
    </domain-config>
</network-security-config>
