{ pkgs, ... }:

let
  # The app's rootfs-extras.nix (goose, hermes, the noexec shebang shim, my-webserver),
  # copied here beside the inputs it reads (rootfs.json, extras.json, noexec-shebang.c),
  # with the same pins the bake uses.
  extras = import ./rootfs-extras.nix { inherit pkgs; };
in
{
  # Exactly what the app bakes: build.json default_packages.attrs, then extras.attrs.
  environment.packages = [
@PACKAGES@
@EXTRAS@
    (pkgs.callPackage ./android-host-tools.nix { })
  ];

  user.shell = "${pkgs.@LOGIN_SHELL@}/bin/@LOGIN_SHELL@";

  environment.etcBackupExtension = ".bak";

  nix.extraOptions = ''
    experimental-features = nix-command flakes
  '';

  system.stateVersion = "24.05";
}
