{
  description = "nix-on-droid system configuration for this device (all users), seeded by cloud-nix-on-droid";

  # Pinned to what the app's baked rootfs was built from: the nixpkgs the default
  # packages came from and the nix-on-droid revision its bootstrap was cut from.
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/@NIXPKGS_PIN@";
    nix-on-droid = {
      url = "github:nix-community/nix-on-droid/@NOD_REV@";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    hm = {
      url = "path:@HOME@/@HOME_DIR@/hm";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.nix-on-droid.follows = "nix-on-droid";
    };
  };

  outputs = { self, nixpkgs, nix-on-droid, hm }: {
    # nix-on-droid switch --flake @HOME@/@HOME_DIR@/system
    nixOnDroidConfigurations.default = nix-on-droid.lib.nixOnDroidConfiguration {
      pkgs = import nixpkgs {
        system = "@NIX_SYSTEM@";
        config.allowUnfree = true; # claude-code
      };
      modules = [
        ./nix-on-droid.nix
        {
          home-manager = {
            useGlobalPkgs = true;
            backupFileExtension = "hm-bak";
            config = hm.homeModules.default;
          };
        }
      ];
    };
  };
}
