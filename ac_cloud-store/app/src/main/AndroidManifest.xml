<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- #865 Cloud Store: the constellation store as its own APK. The install
         engine (libs:updater) brings INTERNET, POST_NOTIFICATIONS,
         REQUEST_INSTALL_PACKAGES, UPDATE_PACKAGES_WITHOUT_USER_ACTION and its
         install-result receiver through the manifest merge. What the STORE
         pages add on top is declared here. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Phone tab: Uninstall on a row. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Phone tab: Stop on a row (#859). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Phone tab lists every installed app, and the fleet list reads the
         installed version of every constellation package. Self-signed APK,
         no Play distribution, same as cloud-superapp. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- #894 Cloud Store's own shell channel. Wireless-debugging pairing runs in a foreground
         service (the lib's AdbPairingService, declared below), which needs the notification, the
         foreground-service and mDNS/network permissions; WRITE_SECURE_SETTINGS can only be held
         through `pm grant` by the channel itself and lets each boot turn Wireless debugging back
         on; BOOT_COMPLETED re-arms the channel, whose connection is process state. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudStore"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- SuperApp opens a given tab: com.diegonmarcos.cloudstore.OPEN + extra "tab". -->
            <intent-filter>
                <action android:name="com.diegonmarcos.cloudstore.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- #894 the pairing flow's foreground service (libs:shizuku-adb-debug-tools). The lib's own
             manifest declares the same service; it is restated here so Cloud Store's manifest is the
             record of what it runs, and the merger folds the two. -->
        <service
            android:name="com.diegonmarcos.superapp.adbdebug.AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pairs this app's embedded adb client with the phone's own Wireless debugging while the user types the pairing code into the notification" />
        </service>

        <!-- HostShellService (libs:shizuku-adb-debug-tools): holds the process up so the embedded adb
             channel and the fleet debug server (both process state) survive in the background. -->
        <service
            android:name="com.diegonmarcos.superapp.adbdebug.HostShellService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps this app's on-device shell channel and its loopback debug server running between uses" />
        </service>
        <receiver
            android:name=".shell.ShellBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Same provider cloud-superapp declares: lets the Shizuku install
             channel bind when Shizuku is present. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- #903 the dataSync foreground service a running batch (Download all /
             Update all / the auto chain / one row's Install) holds, so Android
             and Samsung's freezer leave the process and its network alone.
             libs:updater declares it too; restated here so this manifest is the
             record of what the app runs, and the merger folds the two. -->
        <service
            android:name="com.diegonmarcos.superapp.updater.BatchForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- #903 WorkManager's own foreground service runs the download/install
             workers' ForegroundInfo, so it needs the same type. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />
    </application>
</manifest>
