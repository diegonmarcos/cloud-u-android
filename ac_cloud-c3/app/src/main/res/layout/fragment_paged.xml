<?xml version="1.0" encoding="utf-8"?>
<!-- #648 the shape every content tab wears: a sub-page strip over one page container.
     ONE layout for all of them, so adding a page is a build.json edit and never a second
     strip. The strip is built at runtime from that tab's declared pages (PagedFragment) —
     there is no res/menu, because a static menu file would be a second list to keep in
     step with the declaration, which is how the SuperApp's bottom-nav icons went stale. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/page_strip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/page_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
