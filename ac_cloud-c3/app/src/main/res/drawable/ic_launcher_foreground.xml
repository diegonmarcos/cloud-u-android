<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground (108dp viewport; inner 72dp safe area). Unified
     Cloud icon family: bold white app glyph, dominant + centred, with the
     shared translucent "cloud" tick top-right.

     #630 THE GLYPH IS A DRIVE. It used to be Material `public` — the meridian
     globe — which is the browser/web mark, not a storage one, and on the home
     screen it read as a second browser beside Cloud Browser. It is now Material
     `storage`: the stacked disk bays, the drive of a storage app.

     THIS FILE IS THE ONE DECLARATION of the Drive glyph. Every other surface is
     a copy OF it, pinned to it rather than trusted:
       · the launcher, through mipmap-anydpi-v26/ic_launcher{,_round}.xml;
       · the SuperApp's Data-Apps tile and the one-hand left-edge `down` sector,
         through aa_cloud-superapp/app/src/main/res/drawable/ic_drive.xml, whose
         paths aa_cloud-superapp/test/test-onehand-app-sector-icon.sh (6c)
         requires to appear VERBATIM here;
       · the constellation Store row and any tile that falls back to the
         installed package's own icon, which is this file.
     So a redraw happens here and nowhere else. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- App glyph (24dp Material `storage`, centred in safe area) -->
    <group android:scaleX="1.917" android:scaleY="1.917" android:translateX="31" android:translateY="35">
        <path android:fillColor="#FFFFFFFF" android:pathData="M2,20h20v-4H2V20zM4,17h2v2H4V17zM2,4v4h20V4H2zM6,7H4V5h2V7zM2,14h20v-4H2V14zM4,11h2v2H4V11z" />
    </group>
    <!-- Shared cloud tick (family mark), top-right, slightly translucent -->
    <group android:scaleX="0.62" android:scaleY="0.62" android:translateX="68.6" android:translateY="20.6">
        <path android:fillColor="#F2FFFFFF" android:pathData="M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.65,-4.96z" />
    </group>
</vector>
