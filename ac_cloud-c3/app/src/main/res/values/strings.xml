<?xml version="1.0" encoding="utf-8"?>
<!-- #648 EVERY caption this app prints. A caption is either a declaration (build.json::ui
     labels) or a string here; no Kotlin file holds a user-facing literal. The launcher label
     itself comes from build.gradle (resValue app_name), which is build.json::name — the
     application's one name (#351). English is the base language (#299) and this is the only
     values/ tree, so there is no values-xx to drift from it.

     Nothing here is declared "for later": a string with no caller is a caption nobody prints,
     which is the same orphan shape this ticket is about. The set below is exactly what the
     shipped pages use. -->
<resources>
    <!-- C3 · Health — MOVED from the SuperApp with the fragment that prints them (#648),
         wording unchanged, because the page was already designed. -->
    <string name="c3_health_title">C3 / Health</string>
    <string name="c3_health_status_split">%1$d public · %2$d private (snapshot from cloud-data)</string>
    <string name="c3_health_section_public">🌐 Public — %1$d services</string>
    <string name="c3_health_section_private">🔒 Private — %1$d services</string>

    <!-- Apps tab. The three names are DERIVED from the fleet ids, so they are not strings. -->
    <string name="apps_open">Open</string>
    <string name="apps_not_installed">Not installed</string>
    <string name="apps_launch_failed">Could not open %1$s</string>

    <!-- Configs ▸ About -->
    <string name="about_title">Cloud C3</string>
    <string name="about_version">Version</string>
    <string name="about_build">Build</string>
    <string name="about_commit">Commit</string>

    <!-- Drawn only when a DECLARED page resolves to no fragment — a declaration that is not
         true. It names the id rather than drawing an empty pane, which would be
         indistinguishable from a page that legitimately has nothing to show. On a shipped
         APK this is unreachable: test-c3-shell.sh fails the build if any declared page has
         no body. -->
    <string name="page_has_no_body">No page is implemented for “%1$s”. The declaration lists it, so this is a bug, not an empty page.</string>
</resources>
