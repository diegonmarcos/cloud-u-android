<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-16 owner decision: all apps must be Compose. The fragment containers the Compose shell and
     the paged tabs host (C3FragmentHost). STABLE resource ids on purpose: View.generateViewId() crashes on
     FragmentManager restore because the regenerated id no longer matches the saved-state host id; fixed
     ids survive process death, which a launcher-adjacent app sees many times an hour. -->
<resources>
    <item name="fragment_container" type="id" />
    <item name="page_container" type="id" />
    <item name="c3_host_key" type="id" />
</resources>
