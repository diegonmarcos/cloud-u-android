name: "Ship → @APP_NAME@ web (Kotlin/Wasm build + attach to GH Release + portal refresh)"

# GENERATED from 1_cicd/src/templates/ship-wasm.yml.in, because @APP_DIR@/build.json
# declares a `web` block (#876). Edit the template or the build.json, never this
# file: the next `./build.sh workflow` overwrites it, and `generated files are up
# to date` fails a push that did not.
#
# The app's Kotlin/Wasm page: @APP_DIR@/@WEB_DIR@ is its own gradle root, and the
# shared libs' pure-Compose sources (src/commonMain/kotlin, the lib list is
# ab_cloud-libs-shared/build.json::web.libs) arrive through the
# ab_cloud-libs-shared/web composite. It ships ALONE: the APK workflow excludes
# @APP_DIR@/@WEB_DIR@ from what it watches and hashes, and this one watches only the
# directories listed below, so a web edit never republishes an APK and an APK edit
# never rebuilds the page. The publish gate weighs the page's own inputs (the
# directories above, plus the fleet manifest the build bakes in), so a run that
# moved none of them leaves the released zip untouched.

on:
  workflow_dispatch: {}
  push:
    branches: [main]
    paths:
      - "@APP_DIR@/@WEB_DIR@/**"
@WEB_TRIGGER_PATHS@
permissions:
  contents: write   # gh release upload

concurrency:
  group: ship-@APP_NAME@-wasm-${{ github.ref }}
  cancel-in-progress: true

env:
  WORK_DIR: @APP_DIR@/@WEB_DIR@
  APP_DIR: @APP_DIR@

jobs:
  build_and_publish:
    name: "Build Kotlin/Wasm + Publish (@APP_NAME@)"
    runs-on: @BUILD_HOST@
    timeout-minutes: 40

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Publish-if-changed, exactly as the APK workflows do it: the identity is the git
      # trees of the inputs listed here (the watched ones, plus the fleet manifest the
      # build bakes into the page, which is hashed and never watched), compared with the
      # <asset>.source sidecar on the release. --asset/--paths-from because this job's
      # asset is not named by a build.json beside it.
      - name: Publish gate (skip when source unchanged)
        id: gate
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          inputs="$RUNNER_TEMP/web-inputs.txt"
          cat > "$inputs" <<'EOF'
@WEB_INPUT_PATHS@
          EOF
          sh 1_cicd/dist/scripts/cloud-android-publish-gate.sh check "$WORK_DIR" "" --asset "@WASM_ASSET@" --paths-from "$inputs"

      - name: Set up JDK 17
        if: steps.gate.outputs.skip != 'true'
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Gradle (cached)
        if: steps.gate.outputs.skip != 'true'
        uses: gradle/actions/setup-gradle@v6

      - name: Build (wasmJsBrowserDistribution)
        if: steps.gate.outputs.skip != 'true'
        run: cd "$WORK_DIR" && ./gradlew wasmJsBrowserDistribution --no-daemon --console=plain

      # The web tester asserts the dist, so it runs AFTER the build and is told
      # to treat an absent dist as a failure (locally it skips, with a reason).
      - name: "Test → the page's dist (contents, size budget, no android in the glue)"
        if: steps.gate.outputs.skip != 'true'
        env:
          CLOUD_WEB_REQUIRE_DIST: "1"
        run: |
          sh 1_cicd/dist/scripts/cloud-android-test-engine.sh shell "$APP_DIR"

      - name: Package @WASM_ASSET@
        id: pack
        if: steps.gate.outputs.skip != 'true'
        run: |
          set -euo pipefail
          dist="$WORK_DIR/build/dist/wasmJs/productionExecutable"
          test -f "$dist/@ENTRY@" || { echo "::error::$dist/@ENTRY@ missing — the build produced no page"; exit 1; }
          mkdir -p "$RUNNER_TEMP/wasm"
          asset="$RUNNER_TEMP/wasm/@WASM_ASSET@"
          (cd "$dist" && zip -qr "$asset" .)
          sha256sum "$asset" | cut -d' ' -f1 > "$asset.sha256"
          ls -l "$asset"
          echo "asset=$asset" >> "$GITHUB_OUTPUT"

      - name: Attach to rolling GH Release
        id: publish
        if: steps.gate.outputs.skip != 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          TAG="$(jq -r '.release.gh_release.rolling_tag' "$APP_DIR/build.json")"
          ASSET="${{ steps.pack.outputs.asset }}"
          if ! gh release view "$TAG" >/dev/null 2>&1; then
            gh release create "$TAG" --title "$TAG" --target "$GITHUB_SHA" \
              --notes "Rolling release — overwritten on every main push." --latest
          fi
          gh release upload "$TAG" "$ASSET" "$ASSET.sha256" --clobber
          names="$(gh release view "$TAG" --json assets --jq '.assets[].name')"
          echo "$names" | grep -qxF "$(basename "$ASSET")" \
            || { echo "::error::gh-release: $(basename "$ASSET") missing on $TAG after upload"; exit 1; }

      # The portal (diegonmarcos.github.io, a-Portals/cloud-web) fetches the zip from
      # the release at ITS build time, so it has to be told. repository_dispatch to
      # another repo needs a token with access to it; GITHUB_TOKEN cannot. Without the
      # secret the release is still correct and the portal picks the page up on its
      # next build, so this degrades to a warning, never a red run.
      - name: Stamp source identity on the published asset
        if: steps.gate.outputs.skip != 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          inputs="$RUNNER_TEMP/web-inputs.txt"
          cat > "$inputs" <<'EOF'
@WEB_INPUT_PATHS@
          EOF
          sh 1_cicd/dist/scripts/cloud-android-publish-gate.sh stamp "$WORK_DIR" "" --asset "@WASM_ASSET@" --paths-from "$inputs"

      - name: Tell the portal (repository_dispatch cloud-web-refresh)
        if: steps.gate.outputs.skip != 'true'
        env:
          PORTAL_DISPATCH_TOKEN: ${{ secrets.PORTAL_DISPATCH_TOKEN }}
        run: |
          if [ -z "$PORTAL_DISPATCH_TOKEN" ]; then
            echo "::warning::PORTAL_DISPATCH_TOKEN is not set: @PORTAL_SLUG@ is on the release; the portal takes it at its next build"
            exit 0
          fi
          curl -fsS -X POST \
            -H "Authorization: Bearer $PORTAL_DISPATCH_TOKEN" \
            -H "Accept: application/vnd.github+json" \
            https://api.github.com/repos/diegonmarcos/diegonmarcos.github.io/dispatches \
            -d '{"event_type":"cloud-web-refresh","client_payload":{"slug":"@PORTAL_SLUG@","asset":"@WASM_ASSET@"}}'
