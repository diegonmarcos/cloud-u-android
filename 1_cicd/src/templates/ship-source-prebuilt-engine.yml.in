name: "Ship → @APP_NAME@ APK (source build against the prebuilt engine + GHCR via ORAS + GH Release)"

# GENERATED from 1_cicd/src/templates/ship-source-prebuilt-engine.yml.in, because
# @APP_DIR@/build.json declares build.mode "source-prebuilt-engine".
# Edit the template or the build.json, never this file: the next
# `./build.sh workflow` overwrites it, and `generated files are up to date` fails
# a push that did not.
#
# Built from source: upstream.online fetched at its pinned revision with patches/
# applied, configured with --with-prebuilt-engine so that BOTH native libraries
# are packaged byte for byte from the sha256-pinned released APK. No NDK and no
# engine compile — what runs is a Node build of browser/ and a Gradle build of
# android/. Every value is read from build.json by the vendored engine,
# @APP_DIR@/build.sh.

on:
  workflow_dispatch: {}
  push:
    branches: [main]
    paths:
      - "1_cicd/src/cicd/ship-@APP_NAME@.yml"
      - "1_cicd/src/scripts/@ENGINE@"
      - "1_cicd/src/templates/ship-source-prebuilt-engine.yml.in"
      - "@APP_DIR@/**"
@MODULE_TRIGGER_PATHS@
permissions:
  contents: write   # gh release upload
  packages: write   # ghcr push (oras)

concurrency:
  group: ship-@APP_NAME@-${{ github.ref }}
  cancel-in-progress: true

env:
  WORK_DIR: @APP_DIR@

jobs:
  build_and_publish:
    name: "Build from source + Publish (@APP_NAME@)"
    runs-on: @BUILD_HOST@
    timeout-minutes: 240

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Tests first, deliberately NOT gated on the publish gate: editing a
      # tester does not move the APK, and gating it would let a new assertion
      # land without ever executing.
      - name: "Test → this application's testers, and what is not covered"
        run: |
          sh 1_cicd/dist/scripts/cloud-android-test-engine.sh shell "$WORK_DIR"
          sh 1_cicd/dist/scripts/cloud-android-test-engine.sh lint  "$WORK_DIR"
          sh 1_cicd/dist/scripts/cloud-android-test-engine.sh unit  "$WORK_DIR"

      # THE GUARD THAT REFUSED TO MIRROR, KEPT. It existed because this app's
      # build.json pins upstream.online while its workflow republished a
      # prebuilt APK. This workflow is only generated for the source build, so
      # on its own the branch below is unreachable; it stays so that a
      # build.json which loses its build mode or its host fails here, loudly,
      # instead of dying hours later on a runner that cannot carry the build.
      - name: Refuse to publish a source build this workflow was not generated for
        run: |
          set -euo pipefail
          bj="${WORK_DIR}/build.json"
          if [ -n "$(jq -r '.upstream.online // empty' "$bj")" ] \
             && { [ "$(jq -r '.build.mode // empty' "$bj")" != "source-prebuilt-engine" ] \
                  || [ -z "$(jq -r '.build.host // empty' "$bj")" ]; }; then
            echo "::error title=Not a source build::${WORK_DIR} is a SOURCE BUILD (upstream.online is pinned), but build.json::build.mode is not source-prebuilt-engine or build.json::build.host is not set. It will not publish."
            echo "Pinned online revision : $(jq -r '.upstream.online.revision'      "$bj")"
            echo "Engine (prebuilt) sha256: $(jq -r '.upstream.engine.source.sha256' "$bj")"
            echo "Build mode              : $(jq -r '.build.mode // "NOT SET"'       "$bj")"
            echo "Build host              : $(jq -r '.build.host // "NOT SET"'       "$bj")"
            exit 1
          fi

      - name: Publish gate (skip when source unchanged)
        id: gate
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: sh 1_cicd/dist/scripts/cloud-android-publish-gate.sh check "$WORK_DIR" ""

      - name: Set up JDK 21
        if: steps.gate.outputs.skip != 'true'
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Install build host packages + ORAS + sops
        if: steps.gate.outputs.skip != 'true'
        run: |
          set -euo pipefail
          bash "$WORK_DIR/build.sh" host-deps
          curl -fsSL https://github.com/oras-project/oras/releases/download/v1.2.0/oras_1.2.0_linux_amd64.tar.gz \
            | sudo tar -xz -C /usr/local/bin oras
          curl -fsSL https://github.com/getsops/sops/releases/download/v3.9.4/sops-v3.9.4.linux.amd64 \
            | sudo tee /usr/local/bin/sops >/dev/null
          sudo chmod +x /usr/local/bin/sops
          oras version && sops --version

      - name: Checkout vault (shared Android signing key)
        if: steps.gate.outputs.skip != 'true'
        uses: actions/checkout@v4
        with:
          repository: diegonmarcos/cloud-me_vault
          token: ${{ secrets.ANDROID_SIGNING_VAULT_TOKEN }}
          path: .vault

      # Gerrit serves neither sha fetches nor blob filters, so the pinned clone
      # is a ten-minute, 480 MB fetch. Cached by revision; saved right after
      # materialize so a later failure does not throw the fetch away.
      - name: Read pinned revision
        if: steps.gate.outputs.skip != 'true'
        id: pin
        run: echo "revision=$(jq -r '.upstream.online.revision' "$WORK_DIR/build.json")" >> "$GITHUB_OUTPUT"

      - name: Restore upstream clone
        if: steps.gate.outputs.skip != 'true'
        id: clone_cache
        uses: actions/cache/restore@v4
        with:
          path: ${{ runner.temp }}/cloud-office/online/.git
          key: @APP_NAME@-online-${{ steps.pin.outputs.revision }}

      - name: Materialize (pinned upstream + patches/)
        if: steps.gate.outputs.skip != 'true'
        run: bash "$WORK_DIR/build.sh" materialize

      - name: Save upstream clone
        if: ${{ steps.gate.outputs.skip != 'true' && steps.clone_cache.outputs.cache-hit != 'true' }}
        uses: actions/cache/save@v4
        with:
          path: ${{ runner.temp }}/cloud-office/online/.git
          key: @APP_NAME@-online-${{ steps.pin.outputs.revision }}

      - name: Engine payload (sha256-pinned released APK)
        if: steps.gate.outputs.skip != 'true'
        run: bash "$WORK_DIR/build.sh" payload

      - name: Configure (--with-prebuilt-engine)
        if: steps.gate.outputs.skip != 'true'
        run: bash "$WORK_DIR/build.sh" configure

      - name: Build + sign with the shared constellation key
        if: steps.gate.outputs.skip != 'true'
        env:
          VAULT_DIR: ${{ github.workspace }}/.vault
          SOPS_AGE_KEY: ${{ secrets.SOPS_AGE_KEY }}
        run: bash "$WORK_DIR/build.sh" build

      - name: Attach to rolling GH Release
        id: publish
        if: steps.gate.outputs.skip != 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          TAG="$(jq -r '.release.gh_release.rolling_tag' "$WORK_DIR/build.json")"
          ASSET="$(bash "$WORK_DIR/build.sh" asset-path)"
          # The in-app updater compares this digest, never the size: two distinct
          # builds of equal size once hid a real update.
          sha256sum "$ASSET" | cut -d' ' -f1 > "$ASSET.sha256"
          if ! gh release view "$TAG" >/dev/null 2>&1; then
            gh release create "$TAG" --title "$TAG" --target "$GITHUB_SHA" \
              --notes "Rolling release — overwritten on every main push." --latest
          fi
          gh release upload "$TAG" "$ASSET" "$ASSET.sha256" --clobber
          local_size="$(wc -c <"$ASSET")"
          remote_size="$(gh release view "$TAG" --json assets --jq ".assets[] | select(.name==\"$(basename "$ASSET")\") | .size")"
          names="$(gh release view "$TAG" --json assets --jq '.assets[].name')"
          echo "$names" | grep -qxF "$(basename "$ASSET")" && echo "$names" | grep -qxF "$(basename "$ASSET").sha256" \
            && [ -n "$remote_size" ] && [ "$remote_size" = "$local_size" ] \
            || { echo "::error::gh-release: $(basename "$ASSET") or its .sha256 sidecar missing/size-mismatched on $TAG after upload (remote=$remote_size local=$local_size)"; exit 1; }

      - name: Push to GHCR via ORAS
        if: steps.gate.outputs.skip != 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GHCR_CREATE_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          echo "${{ secrets.GHCR_TOKEN || secrets.GITHUB_TOKEN }}" \
            | oras login ghcr.io -u "${{ github.actor }}" --password-stdin
          BJ="$WORK_DIR/build.json"
          REF="$(jq -r '.release.ghcr.registry + "/" + .release.ghcr.namespace + "/" + .release.ghcr.image' "$BJ")"
          MT="$(jq -r '.release.ghcr.media_type' "$BJ")"
          ASSET="$(bash "$WORK_DIR/build.sh" asset-path)"
          # A GHCR package's visibility is fixed by the token that CREATES it:
          # create with GITHUB_TOKEN so it inherits this public repository,
          # update with the ambient login.
          CREDS=()
          PKG="${REF##*/}"
          if ! gh api "/user/packages/container/${PKG}" >/dev/null 2>&1; then
            CREDS=(--username "${GITHUB_ACTOR:-diegonmarcos}" --password "${GHCR_CREATE_TOKEN}")
          fi
          cd "$(dirname "$ASSET")"
          oras push "${CREDS[@]}" "$REF:latest" "$(basename "$ASSET"):$MT" \
            --artifact-type "$MT" \
            --annotation "org.opencontainers.image.revision=$GITHUB_SHA" \
            --annotation "org.opencontainers.image.source=https://github.com/${{ github.repository }}" \
            --annotation "org.opencontainers.image.version=$(jq -r '.upstream.online.revision[0:12]' "$GITHUB_WORKSPACE/$BJ")" \
            --annotation "org.opencontainers.image.title=$(basename "$ASSET")"
          oras manifest fetch "$REF:latest" --descriptor

      - name: Stamp source identity on the published assets
        if: steps.gate.outputs.skip != 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: sh 1_cicd/dist/scripts/cloud-android-publish-gate.sh stamp "$WORK_DIR" ""
