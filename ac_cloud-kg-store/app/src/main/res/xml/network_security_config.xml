<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere except the WireGuard mesh: the fleet agent gateway (my-ai-api) is http on its mesh address
     (WireGuard encrypts the hop, assets/ai/ai.json gateway.mesh_only), whose host libs/ai/ai-gateway.gradle bakes from
     the fleet catalogue. Loopback stays cleartext for the fleet debug server libs:devtools runs on 127.0.0.1. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- BEGIN fleet-mesh-cleartext (generated from ac_cloud-account/build.json::fleet_endpoints by 1_cicd/src/scripts/cloud-android-fleet-nsc.py; do not edit) -->
        <domain includeSubdomains="false">c3-infra-api.mesh.diegonmarcos.com</domain>
        <domain includeSubdomains="false">c3-public-api.mesh.diegonmarcos.com</domain>
        <domain includeSubdomains="false">cloud-cgc-pub-mcp.mesh.diegonmarcos.com</domain>
        <domain includeSubdomains="false">cloud-cgc-pvt-mcp.mesh.diegonmarcos.com</domain>
        <domain includeSubdomains="false">cloud-me-api.mesh.diegonmarcos.com</domain>
        <domain includeSubdomains="false">embeddings-api.mesh.diegonmarcos.com</domain>
        <domain includeSubdomains="false">my-ai-api.mesh.diegonmarcos.com</domain>
        <!-- END fleet-mesh-cleartext -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
