<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same palette as the watchdog panel, so the two apps read as one
         system. The window background matches the WebView's so there is no
         white flash before a remote page paints. -->
    <style name="Theme.Morpheus" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/kit_surface</item>
        <item name="android:statusBarColor">@color/kit_surface_selected</item>
        <item name="android:navigationBarColor">@color/kit_surface</item>
    </style>
</resources>
