{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Cloud Notes",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "cloud-notes",
        "@cloud-notes/server",
        "dev"
      ]
    },
    {
      "name": "Lanuch Cloud Notes Web",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "cloud-notes",
        "@cloud-notes/web",
        "dev"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug Cloud Notes Web",
      "url": "http://localhost:8080"
    }
  ]
}