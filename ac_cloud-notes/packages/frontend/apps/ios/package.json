{
  "name": "@cloud-notes/ios",
  "version": "0.27.5",
  "description": "Cloud Notes Desktop Web application",
  "type": "module",
  "private": true,
  "browser": "src/index.tsx",
  "scripts": {
    "build": "cloud-notes bundle",
    "dev": "cloud-notes bundle --dev",
    "sync": "cap sync",
    "sync:dev": "CAP_SERVER_URL=http://localhost:8080 cap sync",
    "xcode": "cap open ios",
    "codegen": "r ./codegen.ts"
  },
  "dependencies": {
    "@cloud-notes/component": "workspace:*",
    "@cloud-notes/core": "workspace:*",
    "@cloud-notes/env": "workspace:*",
    "@cloud-notes/graphql": "workspace:*",
    "@cloud-notes/i18n": "workspace:*",
    "@cloud-notes/mobile-shared": "workspace:*",
    "@cloud-notes/nbstore": "workspace:*",
    "@cloud-notes/track": "workspace:*",
    "@blocksuite/cloud-notes": "workspace:*",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.0",
    "@toeverything/infra": "workspace:^",
    "async-call-rpc": "^6.4.2",
    "capacitor-plugin-app-tracking-transparency": "^3.0.0",
    "idb": "^8.0.0",
    "next-themes": "^0.4.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@cloud-notes-tools/cli": "workspace:*",
    "@cloud-notes-tools/utils": "workspace:*",
    "@capacitor/cli": "^8.4.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
