  "html": {
    "_doc": "A page renders in an iframe with an opaque origin: sandbox has allow-scripts only (no same-origin, forms, popups, top navigation, downloads), and a CSP inside the document. Offline by default: default-src none, so a CDN script or font is blocked. cdn.default false; the toggle (per tab, never remembered across vaults) adds ONLY the hosts listed here, for scripts, styles and fonts. The vault's book (2.1.1) loads Tailwind from cdn.tailwindcss.com and Inter from Google Fonts; both are listed.",
    "sandbox": "allow-scripts",
    "csp_default": {
      "default-src": [
        "'none'"
      ],
      "img-src": [
        "data:",
        "blob:"
      ],
      "style-src": [
        "'unsafe-inline'"
      ],
      "font-src": [
        "data:"
      ],
      "script-src": [
        "'unsafe-inline'"
      ],
      "connect-src": [
        "'none'"
      ],
      "frame-src": [
        "'none'"
      ],
      "form-action": [
        "'none'"
      ],
      "base-uri": [
        "'none'"
      ]
    },
    "cdn": {
      "default": false,
      "label": "Allow CDN scripts and fonts",
      "script": [
        "https://cdn.tailwindcss.com",
        "https://cdn.jsdelivr.net",
        "https://unpkg.com",
        "https://cdnjs.cloudflare.com"
      ],
      "style": [
        "https://fonts.googleapis.com",
        "https://cdn.jsdelivr.net",
        "https://unpkg.com",
        "https://cdnjs.cloudflare.com"
      ],
      "font": [
        "https://fonts.gstatic.com",
        "https://cdn.jsdelivr.net",
        "https://cdnjs.cloudflare.com"
      ],
      "script_extra": [
        "'unsafe-eval'"
      ]
    }
  },
