{
  "$schema": "https://github.com/diegonmarcos/cloud-u-android/releases/latest/download/config.schema.json",
  "server": {
    "name": "Cloud Notes Self-hosted",
    "externalUrl": "http://localhost:3010"
  },
  "copilot": {
    "enabled": true,
    "byok": {
      "enabled": true,
      "allowCustomEndpoint": true
    }
  },
  "indexer": {
    "enabled": true,
    "provider.type": "embedded"
  }
}
