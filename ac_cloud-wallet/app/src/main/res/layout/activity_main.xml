<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud Wallet: single full-screen container for WalletFragment.
     The wallet's top-level tabs are the fleet's bottom nav (libs:bottomnav),
     drawn by WalletBottomNav inside the Compose surface, at its bottom (#531).
     fitsSystemWindows pads this container for the system bars, so the island
     inside it takes zero insets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0B0414" />
