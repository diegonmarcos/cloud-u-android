@@ -1377,6 +1378,15 @@ public class LOActivity extends AppCompatActivity {
         return mCloudTextEnhance;
     }
 
+    /** Cloud Office Content Scan (task #461). Created lazily: most sessions never scan. */
+    private CloudContentScan mCloudContentScan;
+
+    private CloudContentScan getCloudContentScan() {
+        if (mCloudContentScan == null)
+            mCloudContentScan = new CloudContentScan(this);
+        return mCloudContentScan;
+    }
+
     /**
      * Passing messages from JS (instead of the websocket communication).
      */
@@ -1527,6 +1537,12 @@ public class LOActivity extends AppCompatActivity {
                 getCloudTextEnhance().onSelection(
                         messageAndParam.length > 1 ? messageAndParam[1] : "");
                 return false;
+            case CloudContentScan.MESSAGE:
+                // OURS, NOT CORE'S — a page snapshot is not a COOL command either.
+                // Blocked here for the same reason as CloudTextEnhance above.
+                getCloudContentScan().onPagePng(
+                        messageAndParam.length > 1 ? messageAndParam[1] : "");
+                return false;
             case "CLOUD_SETTINGS": {
                 // Reached BY ACTION, not by class name — see the intent-filter on
                 // SettingsActivity in android/app's manifest for why.
