-			'cloudsettings'
+			'cloudsettings',
+			'cloudscancontents'
 		],
 
 		// Only these UNO commands will be enabled in redline management mode
@@ -2604,6 +2610,41 @@ class Menubar extends window.L.Control {
 				this._map._clip.setEnhanceRequest(true);
 				app.socket.sendMessage('gettextselection mimetype=text/plain;charset=utf-8');
 			}
+		} else if (id === 'cloudscancontents') {
+			// Cloud Office, task #461 — scan WHAT IS IN THE CURRENT VIEW (barcode +
+			// OCR) through the shared ml-l-image-mlkit engine. The capture is the
+			// canvas the user is looking at: #document-canvas holds the composited
+			// viewport, and toDataURL is a browser API that needs no COOL round-trip.
+			// The snapshot is downscaled to 1600px (the engine's MAX_DECODE_DIMENSION)
+			// so the payload stays small enough for the WebView bridge. Every refusal
+			// names itself: no canvas and a tainted canvas are told apart, and the
+			// Android side always answers with a Toast.
+			if (window.COOLMessageHandler) {
+				const canvas = document.getElementById('document-canvas') as HTMLCanvasElement;
+				if (!canvas) {
+					window.COOLMessageHandler.postMobileMessage('CLOUD_CONTENT_SCAN ' + 'error=no-canvas');
+					return;
+				}
+				try {
+					const scale = Math.min(1, 1600 / Math.max(canvas.width, canvas.height));
+					let out = canvas;
+					if (scale < 1) {
+						out = document.createElement('canvas');
+						out.width = Math.round(canvas.width * scale);
+						out.height = Math.round(canvas.height * scale);
+						const ctx = out.getContext('2d');
+						if (!ctx) {
+							window.COOLMessageHandler.postMobileMessage('CLOUD_CONTENT_SCAN ' + 'error=tainted');
+							return;
+						}
+						ctx.drawImage(canvas, 0, 0, out.width, out.height);
+					}
+					const data = out.toDataURL('image/jpeg', 0.9);
+					window.COOLMessageHandler.postMobileMessage('CLOUD_CONTENT_SCAN ' + data);
+				} catch (e) {
+					window.COOLMessageHandler.postMobileMessage('CLOUD_CONTENT_SCAN ' + 'error=tainted');
+				}
+			}
 		} else if (id === 'cloudsettings') {
 			if (window.COOLMessageHandler) {
 				window.COOLMessageHandler.postMobileMessage('CLOUD_SETTINGS');
