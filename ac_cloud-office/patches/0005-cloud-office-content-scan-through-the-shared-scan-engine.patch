+++ b/android/lib/src/main/java/org/libreoffice/androidlib/CloudContentScan.java
@@ -0,0 +1,160 @@
+/* -*- Mode: java; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Cloud Office — Content Scan.
+ *
+ * This file is not upstream Collabora. It is the Android half of the same
+ * capability the fleet already ships for cloud-drive, cloud-media-center,
+ * cloud-camera and cloud-mail: read what IS in an image (barcode decode + OCR).
+ * Here the image is what the user is looking at — the current page view,
+ * captured in the browser and posted over COOLMessageHandler as a base64 JPEG.
+ *
+ * NOTHING IS REIMPLEMENTED. The scan engine is the ONE shared
+ * libs:ml-l-image-mlkit (ImageScanEngine = ZXing barcode decode + ML Kit OCR)
+ * that the other apps compile in by reference from ab_cloud-libs-shared. This
+ * file only decodes the posted pixels and says what came back — a private copy
+ * of the decode path is the exact defect #170/#261 this fleet fixed.
+ *
+ * NOTHING HERE IS EVER SILENT. Every exit — no canvas, tainted canvas, empty
+ * scan, engine failure — ends in a message on screen. The defect this feature
+ * is fixing WAS the silence.
+ */
+
+package org.libreoffice.androidlib;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Base64;
+import android.util.Log;
+import android.widget.Toast;
+
+import com.diegonmarcos.superapp.image.mlkit.BarcodeScan;
+import com.diegonmarcos.superapp.image.mlkit.ImageScanEngine;
+import com.diegonmarcos.superapp.image.mlkit.OcrResult;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+final class CloudContentScan {
+
+    private static final String TAG = "CloudContentScan";
+
+    /**
+     * The message the browser sends over COOLMessageHandler when the owner picks
+     * Scan contents: "CLOUD_CONTENT_SCAN <data:image base64 url>", or a short
+     * error marker ("error=no-canvas", "error=tainted") when the browser could
+     * not produce a snapshot.
+     *
+     * IT IS OUR MESSAGE, NOT A COOL ONE, so beforeMessageFromWebView must return
+     * false for it and never forward it to postMobileMessageNative — core has no
+     * such command and would log an unknown-message error for every scan.
+     */
+    static final String MESSAGE = "CLOUD_CONTENT_SCAN";
+
+    /** Longest side the engine ever decodes; the browser downscales to this too. */
+    private static final int MAX_SIDE = 1600;
+
+    private final LOActivity activity;
+    private final ImageScanEngine engine;
+
+    /** The engine BLOCKS (ZXing over a bitmap, ML Kit text recognition). Never the main thread. */
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private final Handler main = new Handler(Looper.getMainLooper());
+
+    CloudContentScan(LOActivity activity) {
+        this.activity = activity;
+        this.engine = new ImageScanEngine(activity.getApplicationContext());
+    }
+
+    /**
+     * The browser's snapshot has arrived: decode the base64, run the shared
+     * engine's two halves over it, and say what came back — or why nothing did.
+     */
+    void onPagePng(final String dataUrl) {
+        if (dataUrl == null || !dataUrl.startsWith("data:image/")) {
+            say("Could not read this page view");
+            return;
+        }
+        final Bitmap bitmap = decode(dataUrl);
+        if (bitmap == null) {
+            say("Could not read this page view");
+            return;
+        }
+        final Bitmap safe = (bitmap.getWidth() > MAX_SIDE || bitmap.getHeight() > MAX_SIDE)
+                ? downscale(bitmap) : bitmap;
+        worker.execute(new Runnable() {
+            @Override
+            public void run() {
+                try {
+                    final BarcodeScan barcode = engine.decodeBarcode(safe);
+                    final OcrResult ocr = engine.recognizeText(safe);
+                    main.post(new Runnable() {
+                        @Override
+                        public void run() {
+                            say(compose(barcode, ocr));
+                        }
+                    });
+                } finally {
+                    if (safe != bitmap) safe.recycle();
+                    bitmap.recycle();
+                }
+            }
+        });
+    }
+
+    /** "Barcode: QR_CODE https://…\nText: what the page says" — or the named empty reason. */
+    private String compose(BarcodeScan barcode, OcrResult ocr) {
+        if (barcode == null && (ocr == null || ocr.getText() == null || ocr.getText().trim().isEmpty())) {
+            if (ocr != null && ocr.getError() != null) {
+                // The engine names the failure ("cannot decode the image", "download…");
+                // show it verbatim rather than inventing a friendlier lie.
+                return "Could not read this page view (" + ocr.getError() + ")";
+            }
+            return "No barcode and no readable text were found in this page view.";
+        }
+        final StringBuilder out = new StringBuilder();
+        if (barcode != null) {
+            out.append("Barcode: ")
+                    .append(barcode.getFormat())
+                    .append(" ")
+                    .append(barcode.getRawValue())
+                    .append("\n");
+        }
+        if (ocr != null && ocr.getText() != null && !ocr.getText().trim().isEmpty()) {
+            out.append("Text: ")
+                    .append(ocr.getText().trim());
+        }
+        return out.toString().trim();
+    }
+
+    /** data:image/<type>;base64,<bytes> → Bitmap, or null when the bytes are not an image. */
+    private Bitmap decode(String dataUrl) {
+        try {
+            final int comma = dataUrl.indexOf(',');
+            if (comma < 0) return null;
+            final byte[] bytes = Base64.decode(dataUrl.substring(comma + 1), Base64.DEFAULT);
+            return BitmapFactory.decodeByteArray(bytes, 0, bytes.length);
+        } catch (Exception e) {
+            Log.w(TAG, "cannot decode page snapshot", e);
+            return null;
+        }
+    }
+
+    private Bitmap downscale(Bitmap src) {
+        final float scale = Math.min(1f, (float) MAX_SIDE / Math.max(src.getWidth(), src.getHeight()));
+        return Bitmap.createScaledBitmap(src, Math.round(src.getWidth() * scale),
+                Math.round(src.getHeight() * scale), true);
+    }
+
+    /** The only way this class speaks, and it always speaks. Safe from any thread. */
+    private void say(final String message) {
+        main.post(new Runnable() {
+            @Override
+            public void run() {
+                Toast.makeText(activity, message, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+}
\ No newline at end of file
