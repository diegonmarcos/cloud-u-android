+// a copy vendored in here would be the duplicate-engine defect this fleet fixed
+// (#170/#261). materialize places it at android/ml-l-image-mlkit.
+project(':ml-l-image-mlkit').projectDir = new File(settingsDir, 'ml-l-image-mlkit')
