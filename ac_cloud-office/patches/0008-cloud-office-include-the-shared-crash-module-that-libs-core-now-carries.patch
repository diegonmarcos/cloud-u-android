From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cloud Office <me@diegonmarcos.com>
Date: Thu, 22 Oct 2026 12:00:00 +0000
Subject: [PATCH] cloud-office: include the shared crash module that libs:core
 now carries

libs:core declares `api project(':libs:crash')` since #1122: the default
crash handler, the local crash sink and the generic crash screen live in
that module. The path resolves against THIS settings.gradle, so without an
include the build stops at configuration. materialize places the shared
module at android/libs/crash, next to core and devtools.
---
 android/settings.gradle | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/android/settings.gradle b/android/settings.gradle
--- a/android/settings.gradle
+++ b/android/settings.gradle
@@ -32,3 +32,9 @@
 // file. materialize places it at android/libs/fleetconfig-model.
 include ':libs:fleetconfig-model'
 project(':libs:fleetconfig-model').projectDir = new File(settingsDir, 'libs/fleetconfig-model')
+
+// libs:core `api`s the shared crash module (the default crash handler and screen, #1122);
+// like devtools, its Gradle path is core's to name and resolves against THIS file.
+// materialize places it at android/libs/crash.
+include ':libs:crash'
+project(':libs:crash').projectDir = new File(settingsDir, 'libs/crash')
-- 
