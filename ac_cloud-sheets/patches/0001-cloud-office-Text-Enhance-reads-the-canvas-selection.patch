     @JavascriptInterface
     public void postMobileMessage(String message) {
-        Log.d(TAG, "postMobileMessage: " + message);
-
         String[] messageAndParameterArray= message.split(" ", 2); // the command and the rest (that can potentially contain spaces too)
 
+        if (CloudTextEnhance.MESSAGE.equals(messageAndParameterArray[0])) {
+            // NEVER LOG THIS ONE'S PAYLOAD. It is the owner's document text, and this fleet
+            // ships a diagnostics path that reads logcat and uploads it, so a selection that
+            // reaches the log is a selection that leaves the phone. The length is enough to
+            // debug the bridge with.
+            Log.d(TAG, "postMobileMessage: " + messageAndParameterArray[0] + " ("
+                    + (messageAndParameterArray.length > 1 ? messageAndParameterArray[1].length() : 0)
+                    + " chars, not logged)");
+        } else {
+            Log.d(TAG, "postMobileMessage: " + message);
+        }
+
         if (beforeMessageFromWebView(messageAndParameterArray)) {
             postMobileMessageNative(message);
             afterMessageFromWebView(messageAndParameterArray);
@@ -1358,6 +1368,15 @@ public class LOActivity extends AppCompatActivity {
      */
     public native void postMobileMessageNative(String message);
 
+    /** Cloud Office Text Enhance. Created lazily: most sessions never enhance anything. */
+    private CloudTextEnhance mCloudTextEnhance;
+
+    private CloudTextEnhance getCloudTextEnhance() {
+        if (mCloudTextEnhance == null)
+            mCloudTextEnhance = new CloudTextEnhance(this);
+        return mCloudTextEnhance;
+    }
+
     /**
      * Passing messages from JS (instead of the websocket communication).
      */
@@ -1501,6 +1520,28 @@ public class LOActivity extends AppCompatActivity {
             case "downloadas":
                 initiateSaveAs(messageAndParam[1]);
                 return false;
+            case CloudTextEnhance.MESSAGE:
+                // OURS, NOT CORE'S — return false so it is never forwarded to
+                // postMobileMessageNative, which has no such command and would log an
+                // unknown-message error on every enhance.
+                getCloudTextEnhance().onSelection(
+                        messageAndParam.length > 1 ? messageAndParam[1] : "");
+                return false;
+            case "CLOUD_SETTINGS": {
+                // Reached BY ACTION, not by class name — see the intent-filter on
+                // SettingsActivity in android/app's manifest for why.
+                Intent settings = new Intent("org.libreoffice.androidapp.SETTINGS");
+                settings.setPackage(getPackageName());
+                if (settings.resolveActivity(getPackageManager()) != null) {
+                    startActivity(settings);
+                } else {
+                    // A menu row that does nothing is the defect this app is being fixed
+                    // for. If the filter is ever dropped, say so instead of shrugging.
+                    Toast.makeText(this, "Settings are unavailable in this build",
+                            Toast.LENGTH_LONG).show();
+                }
+                return false;
+            }
             case "exportfile":
                 initiateExportFile(messageAndParam[1]);
                 return false;
