+{
+  "_doc": "Cloud Office's OWN Text Enhance choices — the defaults this app starts from before the owner changes anything. It is a separate file from the Cloud Keyboard's registry on purpose: the owner's standing rule is that a user-editable settings surface is an independently editable copy per app, never a shared link. What is shared is the engine and the provider credential, reached over ITextTools; what is not shared is which style this app rewrites in. See MailTextToolsPrefs in cloud-mail, which was split from the keyboard for exactly this reason.",
+  "_doc_prompt": "The FULLY COMPOSED system prompt is built here and sent whole through ITextTools.enhanceWith. Nothing is added on the serving side — anything added there would be a setting the keyboard still owned, which is the thing this split exists to end.",
+  "preamble": "You rewrite text taken from an office document. Return ONLY the rewritten text, with no preamble, no explanation, no quotation marks around it, and no markdown fences. Preserve the author's meaning and language unless told otherwise.",
+  "default_style": "improve",
+  "styles": [
+    { "id": "improve", "label": "Improve writing", "prompt": "Improve the clarity, flow and word choice of the text. Keep its length close to the original." },
+    { "id": "formal", "label": "Make formal", "prompt": "Rewrite the text in a formal, professional register suitable for business correspondence." },
+    { "id": "concise", "label": "Make concise", "prompt": "Tighten the text. Remove redundancy and filler while keeping every fact and instruction." },
+    { "id": "grammar", "label": "Fix grammar only", "prompt": "Correct spelling, grammar and punctuation ONLY. Do not change wording, tone, or sentence structure otherwise." }
+  ],
+  "_doc_plain_text": "PLAIN TEXT, BOTH DIRECTIONS, AND THAT IS A DECISION. The selection is fetched as text/plain and pasted back as text/plain, so bold, italics, hyperlinks and list markers INSIDE the enhanced range do not survive; the range takes the formatting at the insertion point. Fetching text/html instead would preserve them, but the model would then be free to emit arbitrary markup into the document, and a rewrite that invents a table is far worse than one that flattens a bold word. Revisit this only with a way to constrain the model's output to the tags the selection already had."
+}
diff --git a/android/lib/src/main/java/org/libreoffice/androidlib/CloudTextEnhance.java b/android/lib/src/main/java/org/libreoffice/androidlib/CloudTextEnhance.java
new file mode 100644
index 000000000..7a9f0492e
--- /dev/null
+++ b/android/lib/src/main/java/org/libreoffice/androidlib/CloudTextEnhance.java
@@ -0,0 +1,255 @@
+/* -*- Mode: java; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Cloud Office — Text Enhance.
+ *
+ * This file is not upstream Collabora. It is the Android half of a path with three legs, and
+ * every leg deliberately reuses something that already worked rather than inventing a second
+ * way to do the same thing.
+ *
+ *   LEG 1 — GET THE REAL SELECTED TEXT.
+ *   Collabora's Android text input is a hidden contenteditable that never holds the document
+ *   text; the selection lives in the canvas and in the core process behind it. That is why the
+ *   Cloud Keyboard's Enhance read a blank buffer and silently did nothing for weeks. The only
+ *   thing on this platform that demonstrably gets the real selection is COPY, so this follows
+ *   copy exactly: the browser asks core `gettextselection`, core answers `textselectioncontent:`,
+ *   and Control.Menubar's cloudtextenhance handler forwards that answer here. It is the same
+ *   round trip the Action_Copy PostMessage API makes, with the same one-shot flag on Clipboard
+ *   so the real clipboard is never touched.
+ *
+ *   LEG 2 — REACH THE ENHANCER.
+ *   Not reimplemented here. The routing, the model registry, the chunking of oversized input,
+ *   the timeout and above all the provider API KEY live in the Cloud Keyboard and are reached
+ *   over the existing ITextTools binder. This app calls enhanceWith(), which is the method that
+ *   exists precisely so a caller can hold its OWN settings and hand over its whole decision —
+ *   see cloud-mail, split from the keyboard for the same reason. No key is ever sent, stored or
+ *   read on this side.
+ *
+ *   LEG 3 — PUT IT BACK AS A REAL DOCUMENT EDIT.
+ *   Not a synthetic key event, not a contenteditable write. LOActivity.paste() is the same
+ *   native call the ordinary paste path uses, so core replaces the current selection through its
+ *   own paste, which is ONE undo action. Delete-then-insert would have been two, and the owner
+ *   must be able to undo an enhance in one step.
+ *
+ * NOTHING HERE IS EVER SILENT. Every exit — no selection, peer missing, no key, provider error,
+ * empty reply — ends in a message on screen. The defect this feature is fixing WAS the silence.
+ */
+
+package org.libreoffice.androidlib;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.widget.Toast;
+
+import com.diegonmarcos.superapp.texttools.TextTools;
+import com.diegonmarcos.superapp.texttools.TextToolsClient;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.nio.charset.Charset;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+final class CloudTextEnhance {
+
+    private static final String TAG = "CloudTextEnhance";
+
+    /**
+     * The message the browser sends over COOLMessageHandler when the owner picks Text Enhance
+     * and core has answered with the selection.
+     *
+     * IT IS OUR MESSAGE, NOT A COOL ONE, so beforeMessageFromWebView must return false for it and
+     * never forward it to postMobileMessageNative — core has no such command and would log an
+     * unknown-message error for every enhance.
+     */
+    static final String MESSAGE = "CLOUD_TEXT_ENHANCE";
+
+    /** The paste mimetype, matching the mimetype leg 1 asked core for. See PLAIN TEXT below. */
+    private static final String MIME = "text/plain;charset=utf-8";
+
+    /**
+     * PLAIN TEXT IN, PLAIN TEXT OUT — a stated decision, not an accident.
+     *
+     * Bold, italics, hyperlinks and list markers INSIDE the enhanced range do not survive; the
+     * replacement takes the formatting active at the insertion point. Asking core for text/html
+     * would preserve them, but it would also let the model emit arbitrary markup into a document,
+     * and a rewrite that invents a table is far worse than one that flattens a bold word.
+     */
+    private static final String ASSET = "cloud_text_enhance.json";
+
+    /**
+     * Cloud Office's OWN settings file, in Cloud Office's data directory, under Cloud Office's
+     * uid. Android itself keeps it apart from the keyboard's — no sharedUserId, no settings
+     * provider — which is why these key names may safely match the keyboard's own.
+     */
+    private static final String PREFS = "cloud_text_enhance";
+    private static final String KEY_PROVIDER = "ai_provider";
+    private static final String KEY_MODEL_PREFIX = "ai_model_";
+    private static final String KEY_STYLE = "enhance_style";
+
+    private final LOActivity activity;
+    private final TextToolsClient client;
+
+    /** Every ITextTools call BLOCKS — the binder contract says so. Never the main thread. */
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private final Handler main = new Handler(Looper.getMainLooper());
+
+    CloudTextEnhance(LOActivity activity) {
+        this.activity = activity;
+        this.client = new TextToolsClient(activity);
+    }
+
+    /**
+     * Leg 1's answer has arrived: [selection] is what core says is selected, verbatim.
+     *
+     * NO SELECTION IS A REFUSAL WITH A MESSAGE, NOT A NO-OP. The alternative considered was to
+     * enhance the paragraph at the cursor, which was rejected: it needs a second selection round
+     * trip and it silently edits text the owner never pointed at. Refusing names the fix, and a
+     * named fix is what the silence never gave anyone.
+     */
+    void onSelection(String selection) {
+        final String text = selection == null ? "" : selection.trim();
+        if (text.isEmpty()) {
+            say("Select the text you want to enhance first");
+            return;
+        }
+        // The peer being absent is a different repair from the peer being asleep, and telling the
+        // owner to install an app they already have is how the translate bar lost their trust.
+        if (!client.isServingAppInstalled()) {
+            say(TextTools.NOT_INSTALLED);
+            return;
+        }
+
+        say("Enhancing…");
+        worker.execute(new Runnable() {
+            @Override
+            public void run() {
+                enhance(text);
+            }
+        });
+    }
+
+    /** Runs on [worker]. Never touches the document directly — that is main-thread work. */
+    private void enhance(String text) {
+        final JSONObject config = readConfig();
+        if (config == null) {
+            say("Text Enhance is misconfigured: " + ASSET + " is missing or unreadable");
+            return;
+        }
+
+        final SharedPreferences prefs =
+                activity.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        // Empty provider/model is the honest first-launch answer, and ITextTools documents it:
+        // the serving app falls back to whatever the owner already configured there. It is not
+        // an error and must not be reported as one.
+        final String providerId = prefs.getString(KEY_PROVIDER, "");
+        final String modelId = prefs.getString(KEY_MODEL_PREFIX + providerId, "");
+        final String prompt = composePrompt(config, prefs.getString(
+                KEY_STYLE, config.optString("default_style", "")));
+
+        // CHUNKING IS NOT DONE HERE, ON PURPOSE. Splitting an oversized selection, sending the
+        // pieces and rejoining them is already implemented once behind this binder, and it is
+        // where the provider's token budget is actually known. A second copy here would drift
+        // from the first and be wrong in a way nothing on screen would show.
+        final TextTools.Result result = client.enhanceWith(text, prompt, providerId, modelId);
+
+        if (!result.ok) {
+            // A network error, a missing key, a provider error and a dead binder all arrive here
+            // carrying a readable reason, because the binder contract refuses to squash a failure
+            // into an empty result. Show it. Never swallow it.
+            say("Text Enhance failed: " + result.error);
+            return;
+        }
+
+        final String enhanced = result.text;
+        if (enhanced == null || enhanced.trim().isEmpty()) {
+            // Pasting this would wipe the owner's text with the model's silence.
+            say("Text Enhance returned nothing — the document was not changed");
+            return;
+        }
+
+        main.post(new Runnable() {
+            @Override
+            public void run() {
+                replaceSelection(enhanced);
+            }
+        });
+    }
+
+    /**
+     * LEG 3. Core's own paste, over the still-live selection, which is ONE undo step.
+     *
+     * The selection is still exactly where leg 1 read it: nothing between the menu tap and here
+     * moves the cursor, because the enhance ran on a worker thread and the document was never
+     * touched. If that ever stops being true the replacement lands in the wrong place, so whoever
+     * adds a document operation to this path has to re-establish the selection first.
+     */
+    private void replaceSelection(String enhanced) {
+        try {
+            activity.paste(MIME, enhanced.getBytes(Charset.forName("UTF-8")));
+        } catch (Throwable t) {
+            // A native paste that throws must not look like a successful enhance.
+            Log.w(TAG, "paste of enhanced text failed", t);
+            say("Text Enhance could not write into the document: " + t.getMessage());
+        }
+    }
+
+    /**
+     * The fully composed system prompt — preamble plus the chosen style, joined HERE.
+     *
+     * ITextTools.enhanceWith requires the caller to compose it whole; anything the serving side
+     * appended would be a setting the keyboard still owned.
+     */
+    private String composePrompt(JSONObject config, String styleId) {
+        final StringBuilder out = new StringBuilder(config.optString("preamble", ""));
+        final JSONArray styles = config.optJSONArray("styles");
+        if (styles == null) return out.toString();
+        for (int i = 0; i < styles.length(); ++i) {
+            final JSONObject style = styles.optJSONObject(i);
+            if (style != null && styleId.equals(style.optString("id"))) {
+                out.append("\n\n").append(style.optString("prompt", ""));
+                break;
+            }
+        }
+        return out.toString();
+    }
+
+    /** The styles asset, read fresh. Small, read once per enhance, not worth a cache. */
+    private JSONObject readConfig() {
+        InputStream in = null;
+        try {
+            in = activity.getAssets().open(ASSET);
+            final ByteArrayOutputStream buffer = new ByteArrayOutputStream();
+            final byte[] chunk = new byte[4096];
+            int read;
+            while ((read = in.read(chunk)) != -1) buffer.write(chunk, 0, read);
+            return new JSONObject(new String(buffer.toByteArray(), Charset.forName("UTF-8")));
+        } catch (Exception e) {
+            Log.e(TAG, "cannot read " + ASSET, e);
+            return null;
+        } finally {
+            if (in != null) try { in.close(); } catch (Exception ignored) { }
+        }
+    }
+
+    /**
+     * The only way this class speaks, and it always speaks.
+     *
+     * A Toast rather than a log line because the whole defect being fixed is a failure nobody
+     * could see. Safe from any thread: it hops to the main looper itself.
+     */
+    private void say(final String message) {
+        main.post(new Runnable() {
+            @Override
+            public void run() {
+                Toast.makeText(activity, message, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+}
