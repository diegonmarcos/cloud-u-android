    <!-- Terminal setup instructions (shown on the Configs page) -->
    <string name="cfg_terminal_setup_title">Terminal setup</string>
    <!-- %1$s is GENERATED by ConfigsActivity.terminalSetupBlocks() — one
         cfg_terminal_setup_env_block per backend declared in
         data/terminal-targets.json. No port, user or env name is written here:
         a literal would be a second declaration of a value the app already
         dials from the JSON, and the two spellings drifted (the instructions
         named port 8022 for nix-on-droid while the app connected to 8024). -->
    <string name="cfg_terminal_setup_steps">The terminal SSHes over loopback ONLY. Start the env\'s sshd bound to LOOPBACK — it is never reachable from WiFi/mobile:\n\n%1$s\n(-o ListenAddress binds loopback only — no 0.0.0.0, no network interface.)\n\nThen in this app:\n1. Terminal SSH key → copy → append to ~/.ssh/authorized_keys in that env.\n2. Terminal backend → pick the env.\n3. Terminal connection → host / port / user → Test until ✓.\n4. Open the terminal from Home.</string>
    <!-- One per declared backend. %1$s label, %2$s user, %3$s host, %4$d port,
         %5$s the env's own sshd install command (sshd_install in the JSON —
         the two envs do not share a package manager). -->
    <string name="cfg_terminal_setup_env_block">%1$s  (port %4$d, user %2$s)\n  %5$s\n  ssh-keygen -A\n  sshd -p %4$d -o ListenAddress=%3$s\n</string>
