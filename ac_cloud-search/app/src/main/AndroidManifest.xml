<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The sources, feeds and the AI chat (core/Engine.kt UrlHttp, over Android's resolver so the
         SuperApp's DNS menu applies). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- #903 Things: the stores around the person. COARSE only (a city-block fix from the network
         provider), requested once from the page, and never stored: it only centres the search (the
         centre leaves the phone rounded to ~1 km). Optional: without it, the city typed in settings
         is used. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <queries>
        <!-- Where results open (build.json::open_with, resolved from the fleet manifest): without
             this line cloud-browser is invisible on API 30+ and every link would go elsewhere. -->
        <package android:name="${browserPackage}" />
        <!-- #913 the Agents tab reads Cloud Mail through its read-only agent door (a signature-guarded provider),
             needs the package to be visible on API 30+. -->
        <package android:name="${mailPackage}" />
        <!-- #913 Cloud Search ▸ Apps shows which fleet apps are installed and launches them: every launcher app is visible
             through this intent query, so no fleet package is listed here (and none is spelled twice). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- #903 The fleet bearer for the Things price service is read from these two providers
             (data/FleetBearer.kt): on API 30+ an unqueried package's provider reads as absent. -->
        <package android:name="com.diegonmarcos.cloudaccount" />
        <package android:name="com.diegonmarcos.superapp" />
        <!-- Any browser, the fallback when cloud-browser is not installed. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudSearch"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudSearch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- #937 a query from outside lands on the Search page and runs (libs:fleetconfig-model
                 CloudSearchQuery is the contract): SuperApp's Search "<text>" in Cloud Search row and
                 any app's search intent (SearchManager.QUERY), and Share > Cloud Search of plain text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Registers /api/search/* on the fleet debug server. Not exported, not a real provider. -->
        <provider
            android:name=".debugapi.SearchDebugApiProvider"
            android:authorities="${applicationId}.searchdebugapi"
            android:exported="false" />
    </application>
</manifest>
