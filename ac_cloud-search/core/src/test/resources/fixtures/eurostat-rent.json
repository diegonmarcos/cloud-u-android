{"version":"2.0","class":"dataset","label":"Harmonised index of consumer prices (HICP) - ECOICOP ver.2 - indices and rates of change, monthly data","source":"ESTAT","updated":"2026-10-02T11:00:00+0200","value":{"0":98.33,"1":98.50,"2":98.63,"3":98.75,"4":98.98,"5":99.16,"6":99.32,"7":99.62,"8":99.83,"9":99.95,"10":100.15,"11":100.28,"12":100.42,"13":100.57,"14":100.78,"15":100.96,"16":101.17,"17":101.37,"18":101.50,"19":101.70,"20":101.88,"21":102.03,"22":102.29,"23":102.45},"id":["freq","unit","coicop18","geo","time"],"size":[1,1,1,1,25],"dimension":{"freq":{"label":"Time frequency","category":{"index":{"M":0},"label":{"M":"Monthly"}}},"unit":{"label":"Unit of measure","category":{"index":{"I25":0},"label":{"I25":"Index, 2025=100"}}},"coicop18":{"label":"Classification of individual consumption by purpose (COICOP) - 2018","category":{"index":{"CP041":0},"label":{"CP041":"Actual rental payments made for housing"}}},"geo":{"label":"Geopolitical entity (reporting)","category":{"index":{"DE":0},"label":{"DE":"Germany"}}},"time":{"label":"Time","category":{"index":{"2024-09":0,"2024-10":1,"2024-11":2,"2024-12":3,"2025-01":4,"2025-02":5,"2025-03":6,"2025-04":7,"2025-05":8,"2025-06":9,"2025-07":10,"2025-08":11,"2025-09":12,"2025-10":13,"2025-11":14,"2025-12":15,"2026-01":16,"2026-02":17,"2026-03":18,"2026-04":19,"2026-05":20,"2026-06":21,"2026-07":22,"2026-08":23,"2026-09":24},"label":{"2024-09":"2024-09","2024-10":"2024-10","2024-11":"2024-11","2024-12":"2024-12","2025-01":"2025-01","2025-02":"2025-02","2025-03":"2025-03","2025-04":"2025-04","2025-05":"2025-05","2025-06":"2025-06","2025-07":"2025-07","2025-08":"2025-08","2025-09":"2025-09","2025-10":"2025-10","2025-11":"2025-11","2025-12":"2025-12","2026-01":"2026-01","2026-02":"2026-02","2026-03":"2026-03","2026-04":"2026-04","2026-05":"2026-05","2026-06":"2026-06","2026-07":"2026-07","2026-08":"2026-08","2026-09":"2026-09"}}}},"extension":{"lang":"EN","description":"<p>The Harmonised Index of Consumer Prices (HICP) measures price changes of various consumer goods and services over time (inflation). This dataset is compiled according to the European Classification&nbsp;of Individual Consumption&nbsp;According to Purpose (ECOICOP)&nbsp;ver. 2, available in base years 2025=100 and 2015=100.&nbsp;&nbsp;</p><p>This dataset includes&nbsp;four monthly&nbsp;indicators:&nbsp;</p><ul><li>the index, measuring price changes in relation to a base year&nbsp;</li><li>the annual rate of change,&nbsp;representing the percentage change in a reference month compared to the same month of the previous year (also called annual inflation)&nbsp;</li><li>the monthly rate of change,&nbsp;representing the percentage change in consumer price indices in a reference month compared to the previous month (also called monthly inflation)</li><li>the 12-month average rate of change,&nbsp;comparing the average index over a 12-month period to the average index previous 12-month period.</li></ul><p><br></p><p>All the rates are calculated from the monthly HICP indices.&nbsp;</p>","id":"PRC_HICP_MINR","agencyId":"ESTAT","version":"1.0","datastructure":{"id":"PRC_HICP_MINR","agencyId":"ESTAT","version":"24.0"},"annotation":[{"type":"CREATED","date":"2026-01-27T09:31:20+0100"},{"type":"DISSEMINATION_DOI_XML","title":"<adms:identifier xmlns:adms=\"http://www.w3.org/ns/adms#\" xmlns:skos=\"http://www.w3.org/2004/02/skos/core.html\" xmlns:dct=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><adms:Identifier rdf:about=\"https://doi.org/10.2908/PRC_HICP_MINR\"><skos:notation rdf:datatype=\"http://purl.org/spar/datacite/doi\">10.2908/PRC_HICP_MINR</skos:notation><dct:creator rdf:resource=\"http://publications.europa.eu/resource/authority/corporate-body/ESTAT\"/><dct:issued rdf:datatype=\"http://www.w3.org/2001/XMLSchema#date\">2026-01-27</dct:issued></adms:Identifier></adms:identifier>"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf","text":"Information note"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf"},{"type":"DISSEMINATION_OBJECT_TYPE","title":"DATASET"},{"type":"DISSEMINATION_TIMESTAMP_DATA","date":"2026-10-02T11:00:00+0200"},{"type":"DISSEMINATION_TIMESTAMP_GLOBAL","date":"2026-10-02T11:00:00+0200"},{"type":"DISSEMINATION_TIMESTAMP_PLANNED","date":"2026-10-02T11:00:00+0200"},{"type":"ESMS_HTML","title":"Explanatory texts (metadata)","href":"https://ec.europa.eu/eurostat/cache/metadata/en/prc_hicp_esms.htm"},{"type":"ESMS_SDMX","title":"Explanatory texts (metadata)","href":"https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/prc_hicp_esms.sdmx.zip"},{"type":"OBS_COUNT","title":"22389206"},{"type":"OBS_PERIOD_OVERALL_LATEST","title":"2026-09"},{"type":"OBS_PERIOD_OVERALL_OLDEST","title":"1996-01"},{"type":"SOURCE_INSTITUTIONS","text":"Eurostat"},{"type":"UPDATE_DATA","date":"2026-10-02T11:00:00+0200"},{"type":"UPDATE_STRUCTURE","date":"2026-10-02T11:00:00+0200"}],"positions-with-no-data":{"freq":[],"unit":[],"coicop18":[],"geo":[],"time":[24]}}}