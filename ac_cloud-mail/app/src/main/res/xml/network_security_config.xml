<?xml version="1.0" encoding="utf-8"?>
<!--
  Trust anchors (#93). Since Android 7 the default configuration trusts only the system
  CA store, so a CA the user installed themselves (Settings > Security > Encryption &
  credentials > Install a certificate > CA certificate) is ignored and a self-hosted
  server with a private CA cannot be reached at all. Adding the user store lets that
  work while the chain and the hostname are still verified by the platform: there is no
  "trust this certificate anyway" prompt anywhere in Sterna. See SECURITY.md.

  Deliberately no cleartextTrafficPermitted attribute on the base config: the default under targetSdk 36 is
  already false, which is exactly the behaviour this file inherits. The ONE exception (#1093) is the fleet's mesh
  endpoint of the mail service (`stalwart.app`): `.app` hosts are WireGuard-only and WG already encrypts, so the mesh
  is plain HTTP. That entry is GENERATED from ac_cloud-account/build.json::fleet_endpoints (never hand-listed), and a
  public host is never cleartext.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- BEGIN fleet-mesh-cleartext (generated from ac_cloud-account/build.json::fleet_endpoints by 1_cicd/src/scripts/cloud-android-fleet-nsc.py; do not edit) -->
        <domain>stalwart.app</domain>
        <!-- END fleet-mesh-cleartext -->
    </domain-config>
</network-security-config>
