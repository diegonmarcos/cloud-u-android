<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules (Android 12+). Backups are disabled via
  android:allowBackup="false"; these exclusions are a defensive backstop covering both
  cloud-backup and device-to-device transfer so that account credentials, the Room cache
  (cached mail), and the settings DataStore never leave the device. See PRIVACY.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sterna_account.xml" />
        <exclude domain="database" path="sterna.db" />
        <exclude domain="database" path="sterna.db-wal" />
        <exclude domain="database" path="sterna.db-shm" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sterna_account.xml" />
        <exclude domain="database" path="sterna.db" />
        <exclude domain="database" path="sterna.db-wal" />
        <exclude domain="database" path="sterna.db-shm" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
