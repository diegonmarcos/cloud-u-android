<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (Android 11 and below). Backups are disabled outright via
  android:allowBackup="false"; this file is a defensive backstop so that, should backup
  ever be re-enabled, the account credentials, the Room cache (cached mail), and the
  settings DataStore are never copied off the device. See PRIVACY.md.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sterna_account.xml" />
    <exclude domain="database" path="sterna.db" />
    <exclude domain="database" path="sterna.db-wal" />
    <exclude domain="database" path="sterna.db-shm" />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
