<?xml version="1.0" encoding="utf-8"?>
<!-- One wing-beat (<600 ms): wings sweep down then settle back with a soft overshoot.
     Animated on Android 12+; older versions show the static first frame. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_tern">
    <target android:name="leftWing">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="18"
                    android:duration="220"
                    android:interpolator="@android:interpolator/accelerate_cubic" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="18"
                    android:valueTo="0"
                    android:duration="360"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="rightWing">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="-18"
                    android:duration="220"
                    android:interpolator="@android:interpolator/accelerate_cubic" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-18"
                    android:valueTo="0"
                    android:duration="360"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
