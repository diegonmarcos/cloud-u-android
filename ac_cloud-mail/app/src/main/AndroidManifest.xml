<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Watch the default network so the inbox resyncs when connectivity returns (#65).
         Already merged in from WorkManager; declared here because the app itself uses it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: recipient autocomplete from device contacts (off by default; opt-in in Settings). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Normal permission (granted at install, nothing asked of the user): lets the app hear
         about a finished boot so the push connection comes back without opening the app (#98). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (Android 11+): let Sterna see and bind the OpenKeychain
         OpenPGP provider for message encryption/signing. -->
    <queries>
        <package android:name="org.sufficientlysecure.keychain" />
        <package android:name="org.sufficientlysecure.keychain.debug" />
        <intent>
            <action android:name="org.openintents.openpgp.IOpenPgpService2" />
        </intent>
    </queries>

    <application
        android:name=".SternaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Sterna">

        <!-- singleTask: a mailto: tap while the app runs re-enters the existing instance via
             onNewIntent instead of stacking a second MainActivity (and a second inbox). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="${appLabel}"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Sterna.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- mailto: links (Codeberg #15) — from browsers/webviews (VIEW+BROWSABLE) and from
                 apps dispatching a compose action (SENDTO). Registers Sterna as an email app in
                 the system's open-with choices. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
            <!-- The OAuth authorization-code return (#55): the browser sends the answer back to
                 <applicationId>://oauth, which re-enters this singleTask activity through
                 onNewIntent.
                 ⛔ The scheme is the ${applicationId} PLACEHOLDER and must stay one. The test app
                 (-PtestApp) is app.sterna.test and installs alongside production; two packages
                 registering one literal scheme make the return non-deterministic — Android picks
                 the handler, and a sign-in tested on the bench proves nothing about either. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="oauth" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mailto" />
            </intent-filter>
            <!-- System "Share" target (Codeberg #45): shared text/links prefill the body, shared
                 files are attached. text/plain plus */* so anything can be emailed. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- specialUse (not dataSync): Android 15+ budgets dataSync FGS and then blocks
             background restarts, which silently killed push on newer devices (#11). The
             persistent user-initiated email-push connection is the canonical specialUse
             case (no Google/FCM alternative exists for self-hosted JMAP/IMAP servers). -->
        <service
            android:name=".push.PushService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Realtime new-mail push over the user's own mail-server connections (JMAP EventSource / IMAP IDLE); no FCM/Google alternative exists for self-hosted servers." />
        </service>

        <!-- UnifiedPush events from the distributor (issue #17): endpoint updates,
             PushVerification and StateChange payloads. The connector decrypts WebPush
             before delivery. Inert unless a distributor app is installed. -->
        <service
            android:name=".push.UnifiedPushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Lets AppCompat persist the in-app language choice on Android 12 and below
             (on Android 13+ the platform stores it). See AppCompatDelegate.setApplicationLocales. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- Restarts the direct push connection after a reboot or an in-place app update
             (issue #98); does nothing when UnifiedPush, battery-saver delivery or no account
             at all means there is no connection of ours to hold. Exported because a manifest
             receiver that is not exported never sees a system broadcast; both actions are
             protected broadcasts, so no other app can trigger it. -->
        <receiver
            android:name=".push.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The home-screen unread counter. Same family as the boot receiver above: it listens to
             one system broadcast and nothing else. Exported because a manifest receiver that is
             not exported never sees a system broadcast at all; APPWIDGET_UPDATE is a protected
             broadcast, so no other app can send it, and the receiver reads nothing from the intent.
             The label is a build placeholder so the test app (-PtestApp) gets its own entry in the
             widget picker: without it the bench offers two identical entries and cannot tell which
             install it is about to put on the home screen. -->
        <receiver
            android:name=".widget.UnreadWidgetProvider"
            android:exported="true"
            android:label="${widgetLabel}">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_info_unread" />
        </receiver>

        <!-- The home-screen list of the latest messages. Same family as the counter above, and its
             own component in every way the system can see: its own provider class, its own
             res/xml, and its own onEnabled/onDisabled (sharing the counter's would switch the
             counter's push off while a counter cell was still on the screen). The label is a
             SECOND build placeholder, filled with a different literal under -PtestApp: two entries
             called the same thing in the widget picker make a bench pass unplayable, and the one
             that is not the test app is the maintainer's real mail. -->
        <receiver
            android:name=".widget.RecentMailWidgetProvider"
            android:exported="true"
            android:label="${latestWidgetLabel}">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_info_recent" />
        </receiver>

        <!-- ⛔ THE ROW FACTORY, AND THE PERMISSION IS THE WHOLE POINT. Listing anything in a widget
             at minSdk 26 means a RemoteViewsService the widget host binds (RemoteCollectionItems
             is API 31+), and a service that any app may bind is a service that hands the sender
             and the subject of every message in every inbox to whoever asks — whatever the
             notification-content setting says, and with no permission of its own to declare.
             android.permission.BIND_REMOTEVIEWS is held by the system alone, so only the widget
             host reaches it. ⛔ Never remove this attribute; never export this service. -->
        <service
            android:name=".widget.RecentMailWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
