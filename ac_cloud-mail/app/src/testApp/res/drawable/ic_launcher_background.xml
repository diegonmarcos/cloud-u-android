<?xml version="1.0" encoding="utf-8"?>
<!-- Test-app icon background. Compiled ONLY when the build is run with -PtestApp (see the
     conditional res srcDir in app/build.gradle.kts); the production build never reads this
     directory. Same shape as the real background, loud amber instead of pale grey, so the
     test app is unmistakable next to production in the launcher. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFC44D" />
                <item android:offset="1" android:color="#FFF57C00" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
