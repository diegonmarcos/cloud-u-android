# Local config / secrets — never commit these.
# keystore.properties is WRITTEN BY THE ENGINE at ship time (cloud-mail-engine.sh,
# signing='keystore_properties') from the one constellation key resolved out of
# sops. It is a build artifact that happens to live at the app root, so it has to
# be ignored here as well as by the repo root's *.jks / *.keystore rules.
local.properties
secrets.properties
keystore.properties

