<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (never in a release APK): the one screen the CI screenshot job types into
  (ac_cloud-keyboard/ci/keyboard-screenshots.sh). A plain text field that asks for the keyboard
  the moment it opens, so the job needs no other app on the emulator.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.diegonmarcos.cloudkeyboard.ShotActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
    </application>
</manifest>
