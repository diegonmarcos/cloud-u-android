<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone Cloud Keyboard app strings.

  These app-res strings win the resource merge over libs:keyboard. The superapp
  app (aa_cloud-superapp/app) carries the identical overrides.

  - app_name: launcher label AND the label WelcomeWizard reads via
    applicationInfo.labelRes. Must be a string RESOURCE — a manifest literal
    gives labelRes==0 → stringResource(0) throws Resources$NotFoundException
    ("String resource ID #0x0") and Settings crashes on open (WelcomeWizard.kt:86).
  - english_ime_name (translatable=false): the IME display name. The lib
    manifest labels the IME service + SettingsActivity with @string/english_ime_name,
    so this is THE name shown in Settings → Languages → Keyboards and the keyboard
    switcher.
  - translate: labels the Translate toolbar key; getStringResourceOrName looks
    the lowercased ToolbarKey name up against the app package.
-->
<resources>
    <string name="app_name">Cloud Keyboard</string>
    <string name="english_ime_name" translatable="false">Cloud Keyboard</string>
    <string name="translate">Translate</string>
</resources>
