{
  "name": "cloud-calc",
  "description": "Diego's Cloud Calc (#767) - an all-in-one calculator over libqalculate, the engine behind Qalculate!. Every number is computed by Cloud-Lib-Calc.apk (ab_cloud-libs-shared/libs/calc), which this app BINDS after a contract handshake and never compiles (#763: an app compiles only what it renders). Five bottom-nav tabs, each a strip of modes declared below in ui.modes: Calc (Standard, Scientific, Programmer, CAS, Physics & Constants), Convert (Units, Currency), Graph, Tools (Date & Time, Finance, Acoustics, Sound meter) and History. A mode is DATA: its kind picks one of six renderers (expression, catalog, converter, form, plot, meter) and everything it shows - keys, options, forms, categories - is declared here. Offline: the only network use is the engine's currency-rate download, on request. English is the base language (#299); dark is the default theme (#336).",
  "category": "android",
  "vendored_engine": null,
  "android": {
    "application_id": "com.diegonmarcos.cloudcalc",
    "_doc_application_id": "The fleet name with its separator dropped, as cloudc3 / clouddrive / cloudwallet.",
    "compile_sdk": 36,
    "min_sdk": 26,
    "target_sdk": 35,
    "version_code": 1,
    "version_name": "0.1.0-dev",
    "abi_filters": [
      "arm64-v8a"
    ]
  },
  "build": {
    "type": "gradle",
    "entry": "build.sh"
  },
  "signing": {
    "_doc": "ONE shared Cloud-constellation signing key for ALL Android apps. KEY LOCATION: A_A0-Providers/D_TOOLS-DEVICES/d2-android/release.jks (OU=Cloud Constellation) + A_A0-Providers/D_TOOLS-DEVICES/d2-android/signing.secrets.yaml.",
    "vault_keystore": "A_A0-Providers/D_TOOLS-DEVICES/d2-android/release.jks",
    "vault_secrets": "A_A0-Providers/D_TOOLS-DEVICES/d2-android/signing.secrets.yaml"
  },
  "diagnostics": {
    "log_sink_url": "",
    "log_sink_stream": "cloud-calc"
  },
  "release": {
    "artifact": {
      "debug": "Cloud-Calc.apk",
      "release": "Cloud-Calc-release.apk"
    },
    "variants": [
      {
        "id": "arm64",
        "abis": [
          "arm64-v8a"
        ],
        "supported_abis": [
          "arm64-v8a",
          "armeabi-v7a"
        ],
        "artifact_debug": "Cloud-Calc.apk",
        "gh_asset": "Cloud-Calc.apk",
        "ghcr_tag_suffix": "",
        "update_tag": "latest"
      },
      {
        "id": "x86_64",
        "abis": [
          "x86_64"
        ],
        "supported_abis": [
          "x86_64",
          "x86"
        ],
        "artifact_debug": "Cloud-Calc-x86_64.apk",
        "gh_asset": "Cloud-Calc-x86_64.apk",
        "ghcr_tag_suffix": "-x86_64",
        "update_tag": "latest-x86_64"
      }
    ],
    "auto_update": {
      "enabled": false,
      "tag": "latest",
      "interval_hours": 6,
      "require_unmetered_network": true,
      "require_charging": false,
      "install_mode": "silent",
      "_doc_max_installs_per_pass": "Most install sessions ONE unattended background pass may open. A background pass cannot show the system install dialog (Android 10+ blocks background activity starts), so each install it starts leaves a tap-to-install notification holding a PackageInstaller session until the user answers it. Unbounded, one pass over the 40-entry fleet opens 40 and the installer hits Android's 50-session cap - 'Too many active sessions for UID'. The remainder is picked up by the next pass. User-initiated 'Update all' is NOT capped: it runs in the foreground where the dialog appears and sessions resolve at once.",
      "max_installs_per_pass": 3,
      "_doc_enabled": "Off because this app compiles no libs:updater (#763, see modules._doc): the Store updates it. Kept as data so the release block has the fleet's shape."
    },
    "ghcr": {
      "enabled": true,
      "registry": "ghcr.io",
      "namespace": "diegonmarcos",
      "image": "cloud-calc",
      "media_type": "application/vnd.android.package-archive",
      "tags": [
        "latest",
        "sha-{sha}",
        "v{version_name}"
      ]
    },
    "gh_release": {
      "enabled": true,
      "rolling_tag": "latest",
      "asset_name": "Cloud-Calc.apk",
      "draft": false,
      "prerelease": false,
      "generate_release_notes": false
    },
    "phone_install": {
      "default_tag": "latest",
      "target_dir": "~/storage/downloads",
      "asset_name": "Cloud-Calc.apk"
    }
  },
  "modules": {
    "_doc": "Single source of truth for the Gradle module graph. settings.gradle iterates this list. libs:calc is NOT here and must never be: it is the engine this app binds (engines.calc), and the engine contract guard (K6) fails the build if any module map points at it. #763: no `logic` lib is compiled in either — not libs:updater, not libs:analytics (lib-classes L4 holds the fleet's backlog of such edges and a new app may not add to it). Cloud Calc is installed and updated by the Store (SuperApp ▸ Constellation), like the 17 other apps that carry no updater.",
    "app": {
      "type": "application",
      "depends_on": [
        "libs:core",
        "libs:bottomnav"
      ]
    },
    "libs:core": {
      "dir": "../ab_cloud-libs-shared/libs/core",
      "type": "library"
    },
    "libs:devtools": {
      "_doc_dir": "Not linked in app/build.gradle: libs:core pulls it in with an `api` dependency, which is what makes this app a fleet mesh member with the debug API (/api/calc/* below) without per-app wiring.",
      "dir": "../ab_cloud-libs-shared/libs/devtools",
      "type": "library"
    },
    "libs:bottomnav": {
      "_doc_dir": "The fleet bottom-nav island: this app supplies its own five entries from ui.tabs (BottomNavEntry/BottomNavIsland/bottomNavInsets/rememberBottomNavCollapse), never cloud-mail's bottomNavItems.",
      "dir": "../ab_cloud-libs-shared/libs/bottomnav",
      "type": "library"
    }
  },
  "engines": {
    "_doc": "THE ENGINE THIS APP BINDS INSTEAD OF COMPILING (the ac_cloud-news shape). `fleet` is the Store row the package is resolved from at build time (an unknown id fails the build) for BuildConfig and <queries>; `action` finds the service ({package} substituted, matching the engine manifest's ${applicationId}.ENGINE); `min_contract` is the lowest engine CONTRACT that answers every method CalcClient calls, read through PackageManager BEFORE binding.",
    "calc": {
      "fleet": "lib-calc",
      "action": "{package}.ENGINE",
      "min_contract": 1
    }
  },
  "ui": {
    "_doc": "EVERY list this app renders. app/build.gradle bakes ui.* into BuildConfig as base64 JSON and Declarations.kt decodes it once; no tab id, mode id, key or form is spelled in Kotlin.",
    "_doc_tabs": "The bottom nav, in display order. A tab shows the modes whose `tab` is its id, in ui.modes order, as a chip strip; test/test-calc-shell.sh fails on a tab with no mode and on a mode naming no tab.",
    "default_tab": "calc",
    "tabs": [
      {
        "id": "calc",
        "label": "Calc",
        "icon": "calculate"
      },
      {
        "id": "convert",
        "label": "Convert",
        "icon": "swap"
      },
      {
        "id": "graph",
        "label": "Graph",
        "icon": "chart"
      },
      {
        "id": "tools",
        "label": "Tools",
        "icon": "tools"
      },
      {
        "id": "history",
        "label": "History",
        "icon": "history"
      }
    ],
    "_doc_modes": "One entry per mode. `kind` picks the renderer: expression (input + autocomplete + keypad + result), catalog (engine items listed by category, tap to evaluate), converter (value + from/to units of an engine category), form (declared fields substituted into declared expressions), plot (y = f(x) sampled by the engine), meter (microphone level + spectrum; the permission is asked only when this mode opens), history (past results and the engine's own variables). `options` is the engine's eval options JSON (libs/calc EvalOptions: in_base, out_base, precision, angle, approx 0 exact/1 exact where possible/2 decimal, mixed_units, unicode). A key is a string inserted as typed, or {label, insert}; the labels AC, DEL and = are the three actions.",
    "modes": [
      {
        "id": "standard",
        "label": "Standard",
        "tab": "calc",
        "kind": "expression",
        "options": {
          "approx": 1
        },
        "keys": [
