            "AC",
            "DEL",
            {
              "label": "( )",
              "insert": "("
            },
            ")"
          ],
          [
            "7",
            "8",
            "9",
            "/"
          ],
          [
            "4",
            "5",
            "6",
            "*"
          ],
          [
            "1",
            "2",
            "3",
            "-"
          ],
          [
            "0",
            ".",
            "%",
            "+"
          ],
          [
            {
              "label": "x²",
              "insert": "^2"
            },
            {
              "label": "√",
              "insert": "sqrt("
            },
            "^",
            "="
          ]
        ]
      },
      {
        "id": "scientific",
        "label": "Scientific",
        "tab": "calc",
        "kind": "expression",
        "options": {
          "approx": 2,
          "angle": 2
        },
        "angle_choices": [
          {
