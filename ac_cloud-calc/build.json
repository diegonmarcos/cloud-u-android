          },
          {
            "kind": "variable",
            "category": "Particle Mass in kg"
          }
        ]
      },
      {
        "id": "units",
        "label": "Units",
        "tab": "convert",
        "kind": "converter",
        "options": {
          "approx": 2,
          "mixed_units": false
        },
        "_doc": "Unit categories are libqalculate's own category titles (units.xml); the units in each come from the engine at run time (items unit <category>), so ~600 units appear with no list here.",
        "categories": [
          "Length",
          "Area",
          "Volume",
          "Mass",
          "Time",
          "Speed",
          "Acceleration",
          "Force",
          "Pressure",
          "Energy",
          "Power",
          "Temperature",
