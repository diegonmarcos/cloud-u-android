        "default": {
          "value": "1",
          "category": "Length"
        }
      },
      {
        "id": "currency",
        "label": "Currency",
        "tab": "convert",
        "kind": "converter",
        "options": {
          "approx": 2,
          "mixed_units": false
        },
        "_doc": "The ONLY network use in the app: `rates` shows the age of the rates the engine has and a button that asks it to fetch fresh ones (CalcEngine.fetchRates, through Android's resolver so the DNS menu applies). Until then the rates compiled into libqalculate are used, and their date is shown.",
        "categories": [
          "Currency"
        ],
        "rates": true,
        "default": {
          "value": "100",
          "category": "Currency",
          "from": "EUR",
          "to": "USD"
        }
      },
      {
        "id": "graphing",
        "label": "Graph",
        "tab": "graph",
        "kind": "plot",
        "plot": {
          "default": "sin(x)",
          "xmin": -10,
          "xmax": 10,
          "steps": 240
        }
      },
      {
        "id": "datetime",
        "label": "Date & Time",
        "tab": "tools",
        "kind": "form",
        "options": {
          "approx": 1
        },
        "forms": [
          {
            "id": "between",
            "label": "Days between",
            "fields": [
              {
                "id": "from",
                "label": "From",
                "default": "2026-01-01"
              },
              {
                "id": "to",
                "label": "To",
                "default": "2026-12-25"
              }
            ],
            "outputs": [
              {
                "label": "Days",
                "expr": "days(\"{from}\", \"{to}\")"
              },
              {
                "label": "Weeks",
                "expr": "days(\"{from}\", \"{to}\") / 7"
              }
            ]
          },
          {
            "id": "add",
            "label": "Add days",
            "fields": [
              {
                "id": "date",
                "label": "Date",
                "default": "2026-10-02"
              },
              {
                "id": "days",
                "label": "Days",
                "default": "90"
              }
            ],
            "outputs": [
              {
                "label": "Date",
                "expr": "addDays(\"{date}\"; {days})"
              }
            ]
          },
          {
            "id": "time",
            "label": "Add times",
            "fields": [
              {
                "id": "a",
                "label": "Time",
                "default": "10:31"
              },
              {
                "id": "b",
                "label": "Plus",
                "default": "8:30"
              }
            ],
            "outputs": [
              {
                "label": "Sum",
                "expr": "{a} + {b} to time"
              }
            ]
          }
        ]
      },
      {
        "id": "finance",
        "label": "Finance",
        "tab": "tools",
        "kind": "form",
        "options": {
          "approx": 2
        },
        "forms": [
          {
            "id": "discount",
            "label": "Discount",
            "fields": [
              {
                "id": "price",
                "label": "Price",
                "default": "80"
              },
              {
                "id": "pct",
                "label": "Discount %",
                "default": "25"
              }
            ],
            "outputs": [
              {
                "label": "Sale price",
                "expr": "({price}) - ({price}) * ({pct})%"
              },
              {
                "label": "You save",
                "expr": "({price}) * ({pct})%"
              }
            ]
          },
          {
            "id": "tip",
            "label": "Tip",
            "fields": [
              {
                "id": "bill",
                "label": "Bill",
                "default": "50"
              },
              {
                "id": "tip",
                "label": "Tip %",
                "default": "15"
              },
              {
                "id": "people",
                "label": "People",
                "default": "2"
              }
            ],
            "outputs": [
              {
                "label": "Tip",
                "expr": "({bill}) * ({tip})%"
              },
              {
                "label": "Total",
                "expr": "({bill}) * (1 + ({tip})%)"
              },
              {
                "label": "Per person",
                "expr": "({bill}) * (1 + ({tip})%) / ({people})"
              }
            ]
          },
          {
            "id": "loan",
            "label": "Loan",
            "fields": [
              {
                "id": "principal",
                "label": "Principal",
                "default": "200000"
              },
              {
                "id": "rate",
                "label": "Annual rate %",
                "default": "5"
              },
              {
                "id": "years",
                "label": "Years",
                "default": "30"
              }
            ],
            "outputs": [
              {
                "label": "Monthly payment",
                "expr": "-pmt(({rate})% / 12, ({years}) * 12, {principal})"
              },
              {
                "label": "Total paid",
                "expr": "-pmt(({rate})% / 12, ({years}) * 12, {principal}) * ({years}) * 12"
              }
            ]
          },
          {
            "id": "interest",
            "label": "Compound interest",
            "fields": [
              {
                "id": "p",
                "label": "Principal",
                "default": "1000"
              },
              {
                "id": "r",
                "label": "Annual rate %",
                "default": "5"
              },
              {
                "id": "y",
                "label": "Years",
                "default": "10"
              },
              {
                "id": "n",
                "label": "Compounds per year",
                "default": "1"
              }
            ],
            "outputs": [
              {
                "label": "Future value",
                "expr": "({p}) * (1 + ({r})% / ({n}))^(({n}) * ({y}))"
              },
              {
                "label": "Interest earned",
                "expr": "({p}) * (1 + ({r})% / ({n}))^(({n}) * ({y})) - ({p})"
              }
            ]
          }
        ]
      },
      {
        "id": "acoustics",
        "label": "Acoustics",
        "tab": "tools",
        "kind": "form",
        "options": {
          "approx": 2
        },
        "forms": [
          {
            "id": "dbsum",
            "label": "Add two levels (dB)",
            "fields": [
              {
                "id": "l1",
                "label": "Level 1 dB",
                "default": "60"
              },
              {
                "id": "l2",
                "label": "Level 2 dB",
                "default": "60"
              }
            ],
            "outputs": [
              {
                "label": "Combined dB",
                "expr": "10 * log10(10^(({l1}) / 10) + 10^(({l2}) / 10))"
              }
            ]
          },
          {
            "id": "sound",
            "label": "Speed of sound in air",
            "fields": [
              {
                "id": "t",
                "label": "Temperature °C",
                "default": "20"
              }
            ],
            "outputs": [
              {
                "label": "Speed",
                "expr": "331.3 * sqrt(1 + ({t}) / 273.15) m/s"
              }
            ]
          },
          {
            "id": "wave",
            "label": "Wavelength",
            "fields": [
              {
                "id": "f",
                "label": "Frequency Hz",
                "default": "440"
              },
              {
                "id": "c",
                "label": "Speed m/s",
                "default": "343"
              }
            ],
            "outputs": [
              {
                "label": "Wavelength",
                "expr": "(({c}) m/s) / (({f}) Hz) to m"
              },
              {
                "label": "Period",
                "expr": "1 / (({f}) Hz) to ms"
              }
            ]
          },
          {
            "id": "ratio",
            "label": "Ratio to dB",
            "fields": [
              {
                "id": "r",
                "label": "Ratio",
                "default": "2"
              }
            ],
            "outputs": [
              {
                "label": "Power dB",
                "expr": "10 * log10({r})"
              },
              {
                "label": "Amplitude dB",
                "expr": "20 * log10({r})"
              }
            ]
          },
          {
            "id": "distance",
            "label": "Level at a distance",
            "fields": [
              {
                "id": "l",
                "label": "Level dB",
                "default": "94"
              },
              {
                "id": "d1",
                "label": "At m",
                "default": "1"
              },
              {
                "id": "d2",
                "label": "To m",
                "default": "10"
              }
            ],
            "outputs": [
              {
                "label": "Level dB",
                "expr": "({l}) - 20 * log10(({d2}) / ({d1}))"
              }
            ]
          }
        ]
      },
      {
        "id": "meter",
        "label": "Sound meter",
        "tab": "tools",
        "kind": "meter",
        "_doc": "Microphone level and spectrum, computed in THIS process: audio capture is granted per package (RECORD_AUDIO), so the engine's process could not record (the libs:contacts boundary, #763 `pinned`). Asked for only when this mode opens. Levels are dBFS plus `calibration_db`, which defaults to 0 because no phone microphone is calibrated: the number is relative unless a known source sets the offset.",
        "meter": {
          "sample_rate": 44100,
          "fft_size": 4096,
          "refresh_ms": 100,
          "calibration_db": 0,
          "a_weighting": true
        }
      },
      {
        "id": "history",
        "label": "History",
        "tab": "history",
        "kind": "history",
        "history": {
          "max_entries": 200
        }
      }
    ],
    "_doc_debug_api": "The routes this app adds to the fleet debug API (libs:devtools AppDebugServer), so a calculation can be checked with the screen locked: /api/calc/eval?expr=&mode= evaluates through the bound engine with that mode's options, /api/calc/modes lists ui.modes, /api/calc/info is the engine handshake + engine info.",
    "debug_api": {
      "group": "calc"
    }
