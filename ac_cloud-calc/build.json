            "fields": [
              {
                "id": "l1",
                "label": "Level 1 dB",
                "default": "60"
              },
              {
                "id": "l2",
                "label": "Level 2 dB",
                "default": "60"
              }
            ],
            "outputs": [
              {
                "label": "Combined dB",
                "expr": "10 * log10(10^(({l1}) / 10) + 10^(({l2}) / 10))"
              }
            ]
          },
          {
            "id": "sound",
            "label": "Speed of sound in air",
            "fields": [
              {
                "id": "t",
                "label": "Temperature °C",
                "default": "20"
              }
            ],
            "outputs": [
              {
                "label": "Speed",
                "expr": "331.3 * sqrt(1 + ({t}) / 273.15) m/s"
              }
            ]
          },
          {
            "id": "wave",
            "label": "Wavelength",
            "fields": [
              {
                "id": "f",
                "label": "Frequency Hz",
                "default": "440"
              },
              {
                "id": "c",
                "label": "Speed m/s",
                "default": "343"
              }
            ],
            "outputs": [
              {
                "label": "Wavelength",
                "expr": "(({c}) m/s) / (({f}) Hz) to m"
              },
              {
                "label": "Period",
                "expr": "1 / (({f}) Hz) to ms"
              }
            ]
          },
          {
            "id": "ratio",
            "label": "Ratio to dB",
            "fields": [
              {
                "id": "r",
                "label": "Ratio",
                "default": "2"
              }
            ],
            "outputs": [
              {
                "label": "Power dB",
                "expr": "10 * log10({r})"
              },
              {
                "label": "Amplitude dB",
                "expr": "20 * log10({r})"
              }
            ]
          },
          {
            "id": "distance",
            "label": "Level at a distance",
            "fields": [
              {
                "id": "l",
                "label": "Level dB",
                "default": "94"
              },
              {
                "id": "d1",
                "label": "At m",
                "default": "1"
              },
              {
                "id": "d2",
                "label": "To m",
                "default": "10"
              }
            ],
            "outputs": [
              {
                "label": "Level dB",
                "expr": "({l}) - 20 * log10(({d2}) / ({d1}))"
              }
            ]
          }
        ]
      },
