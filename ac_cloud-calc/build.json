      {
        "id": "physics",
        "label": "Physics & Constants",
        "tab": "calc",
        "kind": "catalog",
        "options": {
          "approx": 2
        },
        "_doc": "The CODATA constants are libqalculate's own (variables.xml); the categories are its category titles, so nothing is restated here.",
        "catalog": [
          {
            "kind": "variable",
            "category": "Universal Constants"
          },
          {
            "kind": "variable",
            "category": "Electromagnetic Constants"
          },
          {
            "kind": "variable",
            "category": "Atomic and Nuclear Constants"
          },
          {
            "kind": "variable",
            "category": "Physico-Chemical Constants"
          },
          {
            "kind": "variable",
