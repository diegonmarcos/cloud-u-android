<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The panel's own background, so the window behind the WebView matches
         the transcript and there is no white flash before the page paints. -->
    <style name="Theme.Watchdog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/kit_surface</item>
        <item name="android:statusBarColor">@color/kit_surface_selected</item>
        <item name="android:navigationBarColor">@color/kit_surface</item>
    </style>
</resources>
