<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- The Files tab is a real file manager, so it needs the whole of shared storage. On
         Android 11+ that is the special all-files access FilesBridge.requestStorageAccess()
         sends the user to; below it the legacy pair is granted at install time. maxSdkVersion
         keeps the legacy ones from being requested where they no longer mean anything. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <package android:name="com.diegonmarcos.clouddrive" />

        <!-- The Apps tab launches the fleet's data apps (and Tidal) through the system
             launcher. A package query per tile would be a second list of packages to
             keep in step with data/drive-apps.json, so this asks Android the declarative
             question instead: every installed app that offers a launcher MAIN intent is
             reachable, and nothing here names one. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudDrive"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CloudDrive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open an image from another app with the viewer (task #459/#460).
                 PDFs no longer come here: they go straight to PdfReaderActivity below (#577). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- #458/#577: cloud-drive IS the fleet's PDF reader, and the ONE in-process PDF engine
             (#463) lives behind this activity. Any app that hands over application/pdf — cloud-mail's
             attachment chooser above all — reaches the engine through THIS filter and never carries
             a renderer of its own: the way to add a consumer is the manifest, not a copy. The
             Files tab opens its PDF rows here too (FilesBridge.openPdf). Exported for the chooser;
             it takes only a data URI (content:// is the sender's grant, file:// is confined to
             places the app already browses) and nothing else from the intent. configChanges keeps
             a rotation from re-opening a large document: the view re-lays itself out on the same
             page instead. -->
        <activity
            android:name=".PdfReaderActivity"
            android:exported="true"
            android:label="@string/open_in_cloud_drive"
            android:theme="@style/Theme.CloudDrive"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="@string/open_in_cloud_drive">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file"    android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- #567 push 5: the Compose host for the four engine libraries (git manager, full
             editor, rclone, mounts). Started by FilesBridge.openEngine for a result; never
             exported — the page is its only caller. adjustResize so the editor's keyboard
             does not cover the line being typed. -->
        <activity
            android:name=".EngineActivity"
            android:exported="false"
            android:theme="@style/Theme.CloudDrive"
            android:windowSoftInputMode="adjustResize" />

        <!-- Open-with and Share hand a file to another app, and a file:// URI has been illegal
             to send across that boundary since Android 7. Everything leaves through here. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name="com.diegonmarcos.superapp.updater.PackageInstallerReceiver"
            android:exported="false" />
    </application>
</manifest>
