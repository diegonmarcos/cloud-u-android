<?xml version="1.0" encoding="utf-8"?>
<!-- #705 libs:gh is an ENGINE: lib-apks ships it as Cloud-Lib-Gh.apk and an app binds
     GhBackendService instead of compiling gh in. Merged into that APK only — no app links
     this module any more. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- gh talks to GitHub from THIS process now, so the permission follows the engine
         instead of being required of every app that shows a GitHub card. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- #726 a failed sign-in says whether a VPN (a firewall's included) carries this engine's
         traffic; reading that needs the network's capabilities. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- #729 GhLoginKeeper: gh's sign-in polls GitHub while the user is in the browser, and
         Android 15 cuts a backgrounded process's network, so the engine holds the foreground for
         exactly that long. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <!-- Guarded by the constellation's signature-level permission: only APKs signed
             with the Cloud key can bind it. The action is how a client FINDS the service
             (no class name crosses the APK boundary), and CONTRACT is the version it
             checks through PackageManager before binding — see GhBackendService. -->
        <service
            android:name="com.diegonmarcos.cloudlib.gh.GhBackendService"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA">
            <intent-filter>
                <action android:name="${applicationId}.ENGINE" />
            </intent-filter>
            <meta-data
                android:name="com.diegonmarcos.cloud.engine.CONTRACT"
                android:value="1" />
        </service>

        <service
            android:name="com.diegonmarcos.cloudlib.gh.GhLoginKeeper"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the GitHub CLI sign-in polling GitHub while the user approves its one-time code in the browser" />
        </service>
    </application>
</manifest>
