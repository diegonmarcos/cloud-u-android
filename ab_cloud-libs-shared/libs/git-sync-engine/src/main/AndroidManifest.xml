<?xml version="1.0" encoding="utf-8"?>
<!-- libs:git-sync-engine — the GIT SYNC ENGINE (#871), shipped only as Cloud-Lib-Git-Sync-Engine.apk.
     Apps compile libs:git-sync (the contract half) and hand this service one git verb per call; it runs
     JGit from THIS process on the caller's repository, with the credentials the caller sent for that
     call and nothing stored. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fetch, pull, push and clone are this engine's job; apps keep their own INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The repositories live in the shared store (<storage>/CloudDrive/git), and this is another uid: it
         needs its own all-files grant. Store ▸ Access ▸ Android Perms ▸ "Grant missing" gives it to every
         constellation-signed APK that declares it (PermsGrant: appops set <pkg> MANAGE_EXTERNAL_STORAGE
         allow), this one included; without it a verb on a shared-storage path answers the sentence that
         says so. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application>
        <!-- Guarded by the constellation's signature-level permission: only APKs signed
             with the Cloud key can bind it. The action is how the handshaking client FINDS
             the service, and CONTRACT is the version it reads through PackageManager
             before binding. -->
        <service
            android:name="com.diegonmarcos.cloudlib.gitsync.engine.GitSyncEngineService"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA">
            <intent-filter>
                <action android:name="${applicationId}.ENGINE" />
            </intent-filter>
            <meta-data
                android:name="com.diegonmarcos.cloud.engine.CONTRACT"
                android:value="1" />
        </service>
    </application>
</manifest>
