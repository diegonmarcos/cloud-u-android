<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The island's opaque fill, ported from superapp's bg_nav_island.xml. It is darker
         than the window gradient, so the bar reads as a solid box. #532: the FILL ALONE
         now makes up the whole island. The 1dp #33FFFFFF stroke that the XML stacked on
         top is gone, so the island's visible boundary IS the edge of this fill. -->
    <color name="bottom_nav_island_fill">#FF140B26</color>

    <!-- The island's pill and ink, the static Material 3 dark palette SuperApp's launcher theme
         resolves to (colorSurfaceInverse / colorOnSurfaceInverse / colorOnSurfaceVariant); on
         Android 12+ FleetChrome swaps in the dynamic dark palette the same attrs resolve to there.
         The ONE declaration: no app defines an island colour of its own. -->
    <color name="bottom_nav_pill_fill">#FFE6E0E9</color>
    <color name="bottom_nav_pill_ink">#FF322F35</color>
    <color name="bottom_nav_idle_ink">#FFCAC4D0</color>

    <!-- The glass orb: the round coin behind a top icon, declared ONCE (#534). Superapp's
         bg_liquid_glass_pill.xml (the Home hamburger and wallet orbs, and the drawer tabs)
         and cloud-mail's Home shortcut coins both resolve these, so a change to the orb's
         look is one edit here. Values are the ones the superapp drawable carried. -->
    <color name="glass_orb_fill">#FF1A0033</color>
    <color name="glass_orb_stroke">#55B794F4</color>
    <color name="glass_orb_ripple">#22B794F4</color>

    <!-- #868 PageTabs pill colours, from superapp's AppTabsStyle.makePillBg / repaint. -->
    <color name="page_tabs_selected_fill">#447C3AED</color>
    <color name="page_tabs_selected_stroke">#66E9D8FD</color>
    <color name="page_tabs_selected_text">#FFFFFFFF</color>
    <color name="page_tabs_idle_fill">#22FFFFFF</color>
    <color name="page_tabs_idle_stroke">#33FFFFFF</color>
    <color name="page_tabs_idle_text">#AAFFFFFF</color>
    <!-- The strip's LIGHT surface (TabSurface.Light): a strip over a white / near-white page.
         WCAG AA over #FFFFFF .. #CFDEF3: selected text 7.10:1, idle text >= 6.04:1, selected pill
         vs page >= 5.21:1, idle edge vs page >= 3.34:1, focus ring vs page >= 12.5:1. -->
    <color name="page_tabs_light_selected_fill">#FF6D28D9</color>
    <color name="page_tabs_light_selected_stroke">#FF5B21B6</color>
    <color name="page_tabs_light_selected_text">#FFFFFFFF</color>
    <color name="page_tabs_light_idle_fill">#0F000000</color>
    <color name="page_tabs_light_idle_stroke">#FF79747E</color>
    <color name="page_tabs_light_idle_text">#FF49454F</color>
    <color name="page_tabs_light_focus_ring">#FF1D1B20</color>
</resources>
