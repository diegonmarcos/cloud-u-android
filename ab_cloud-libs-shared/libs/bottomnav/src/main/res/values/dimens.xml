<?xml version="1.0" encoding="utf-8"?>
<!-- THE bottom-nav geometry, one declaration each (#565, ported from superapp's
     values/dimens.xml, where #462/#473/#477/#498 settled every number). BottomNavBar.kt
     reads these and nothing else. A literal copied into Kotlin would be a second number
     that can drift away from this one, which is the failure #380/#381/#384/#408/#424
     closed five times. BottomNavIslandTest reads these same resources back and checks
     the rendered layout against them, so the test never restates a number. -->
<resources>
    <!-- #473/#498. The selected capsule's inset from its cell's top and bottom edge.
         Because the island has no vertical padding of its own, this is also the gap
         between the capsule and the island's top and bottom edges. -->
    <dimen name="bottom_nav_pill_inset">6dp</dimen>

    <!-- #473/#498 curvature. The island and the capsule are both full pills. Their end
         arcs are concentric only when the horizontal gap between capsule end and island
         end equals the capsule's vertical inset. So this is an ALIAS of the pill inset,
         not a number of its own. -->
    <dimen name="bottom_nav_end_inset">@dimen/bottom_nav_pill_inset</dimen>

    <!-- #477. The icon+label stack's inset inside the capsule, the same above and below. -->
    <dimen name="bottom_nav_item_vertical_pad">6dp</dimen>

    <!-- #473. Icon-to-label distance, opened up from Material's 4dp so the label has room. -->
    <dimen name="bottom_nav_icon_label_gap">8dp</dimen>

    <!-- #532. How long the scroll-collapse takes, milliseconds. Zero-length under Power Saving. -->
    <integer name="bottom_nav_collapse_ms">220</integer>

    <!-- Accessibility (WCAG 2.5.8 / Android's 48dp floor). The island never lays a cell out
         narrower than bottom_nav_min_touch_target; above five items (MAX_BOTTOM) never narrower
         than bottom_nav_min_cell_width. Either floor reached = the island scrolls horizontally,
         keeping the selected item in view, instead of crushing its cells. The focus ring is drawn
         only while a keyboard, D-pad or switch holds focus on an item or a tab pill. -->
    <dimen name="bottom_nav_min_touch_target">48dp</dimen>
    <dimen name="bottom_nav_min_cell_width">56dp</dimen>
    <dimen name="bottom_nav_focus_ring_width">2dp</dimen>

    <dimen name="bottom_nav_icon_size">24dp</dimen>
    <dimen name="bottom_nav_label_text_size">12sp</dimen>

    <!-- #477. The ONE dimen the island's bottom clearance is bound to. The live
         system-bar and display-cutout inset is added on top at runtime. A fixed dp is
         right for one device and wrong for every other (#407). -->
    <dimen name="bottom_nav_island_bottom_margin">12dp</dimen>

    <!-- #536. The island spans 80% of the width it is given (the screen, when it is
         placed full-width), which leaves 10% clear on each side. -->
    <fraction name="bottom_nav_width_fraction">80%</fraction>

    <!-- #868 PageTabs: the pill tab strip, ported value for value from superapp's AppTabsStyle
         (makePill / makePillBg / inset / equalise) and its tab_strip_* dimens. PageTabsTest reads
         these back, so the render is measured against the declaration and never restated. -->
    <dimen name="page_tabs_strip_padding">4dp</dimen>
    <dimen name="page_tabs_top_inset">10dp</dimen>
    <dimen name="page_tabs_bottom_inset">10dp</dimen>
    <dimen name="page_tabs_pill_pad_h">14dp</dimen>
    <dimen name="page_tabs_pill_pad_v">8dp</dimen>
    <dimen name="page_tabs_pill_margin">3dp</dimen>
    <dimen name="page_tabs_pill_radius">18dp</dimen>
    <dimen name="page_tabs_pill_stroke">1dp</dimen>
    <dimen name="page_tabs_text_size">12sp</dimen>
    <dimen name="page_tabs_text_min_size">8sp</dimen>
    <dimen name="page_tabs_divider_pad">4dp</dimen>
    <!-- Letter spacing in thousandths of an em (0.08em), and the fewest letters of a label ever shown. -->
    <integer name="page_tabs_letter_spacing_milli">80</integer>
    <integer name="page_tabs_min_chars">7</integer>
</resources>
