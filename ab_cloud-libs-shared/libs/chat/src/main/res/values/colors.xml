<?xml version="1.0" encoding="utf-8"?>
<!-- The Mattermost page's palette as KitPalette roles plus its category/mention colours (MattermostFragment
     builds its CloudKitTheme from these), so no colour is spelled in Kotlin. Prefixed chat_: this library is
     merged into every consumer's resources and must not collide with an app's own names. -->
<resources>
    <color name="chat_bg">#FF000000</color>
    <color name="chat_surface">#FF1A1A22</color>
    <color name="chat_selected">#FF3B2A63</color>
    <color name="chat_text">#FFFFFFFF</color>
    <color name="chat_text_dim">#AAFFFFFF</color>
    <color name="chat_accent">#FFB794F4</color>
    <color name="chat_hairline">#33FFFFFF</color>
    <color name="chat_category">#FFB794F4</color>
    <color name="chat_mention">#FFFF6B6B</color>
    <color name="chat_error">#FFFF8888</color>
</resources>
