<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Feed and API fetching happen in the engine now, so INTERNET follows it
         rather than being required of every app that renders headlines. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Guarded by the constellation's signature-level permission: only
             APKs signed with the Cloud key can bind it. The action is how a
             handshaking client FINDS the service, and CONTRACT is the version
             it reads through PackageManager before binding (engine-apk-split,
             move 5: Cloud News binds this and no app declares libs:news, so a
             change here ships Cloud-Lib-News.apk alone). -->
        <service
            android:name="com.diegonmarcos.superapp.news.NewsBackendService"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA">
            <intent-filter>
                <action android:name="${applicationId}.ENGINE" />
            </intent-filter>
            <meta-data
                android:name="com.diegonmarcos.cloud.engine.CONTRACT"
                android:value="1" />
        </service>
    </application>
</manifest>
