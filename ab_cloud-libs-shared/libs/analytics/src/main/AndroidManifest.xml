<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared HERE, not per app: a new consumer cannot forget it. #871 the POST itself now
         runs in the sink engine (Cloud-Lib-Analytics-Sink.apk), which holds its own INTERNET;
         this one stays so no consumer's merged permission set changes under it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Binding the sink engine needs the constellation's signature permission. Most consumers get it
         from libs:core; the upstream forks compile this module with no core, and without it the bind
         is a SecurityException and every event would sit in the queue forever. -->
    <uses-permission android:name="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />

    <!-- Merges into every consumer: on Android 11+ an unqueried package reads exactly like
         "not installed" (engine-apk-split F2). Resolved from the fleet manifest by build.gradle. -->
    <queries>
        <package android:name="${analyticsEnginePackage}" />
    </queries>

    <application>
        <!-- Runs before Application.onCreate(), so consumers get analytics with
             no per-app wiring. ${applicationId} keeps the authority unique —
             a shared authority is an install-time conflict between our apps. -->
        <provider
            android:name="com.diegonmarcos.superapp.analytics.AnalyticsInitProvider"
            android:authorities="${applicationId}.analyticsinit"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
