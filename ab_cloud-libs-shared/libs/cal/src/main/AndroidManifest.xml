<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CalDAV and ICS fetching happen here now, so INTERNET follows the
         engine rather than being required of every app that shows a calendar. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Guarded by the constellation's signature-level permission: only
             APKs signed with the Cloud key can bind it. The action is how a
             handshaking client FINDS the service, and CONTRACT is the version
             it reads through PackageManager before binding (engine-apk-split,
             move 3: Cloud Me binds this instead of compiling libs:cal).
             Cloud Agenda still binds by class name; both keep working. -->
        <service
            android:name="com.diegonmarcos.superapp.cal.CalBackendService"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA">
            <intent-filter>
                <action android:name="${applicationId}.ENGINE" />
            </intent-filter>
            <meta-data
                android:name="com.diegonmarcos.cloud.engine.CONTRACT"
                android:value="1" />
        </service>
    </application>
</manifest>
