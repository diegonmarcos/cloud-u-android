<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: without this a member cannot even see
         the minting app, so the token handshake fails with NameNotFound. One
         package, not QUERY_ALL_PACKAGES — the mesh only ever reads SuperApp. -->
    <queries>
        <package android:name="com.diegonmarcos.superapp" />
        <!-- #733 every OTHER mesh member. Same-signature apps are NOT mutually
             visible on Android 11+ (the documented automatic-visibility list
             has no such entry), so without this FleetPeers.list — and so
             /api/fleet/peers — saw only itself and SuperApp in every member
             that does not happen to hold QUERY_ALL_PACKAGES. A <provider>
             query needs an exact authority and ours are per-package, so the
             marker is an intent action every member's FleetMemberReceiver
             answers (below): one line here makes the whole fleet visible,
             still with no broad grant. -->
        <intent>
            <action android:name="com.diegonmarcos.cloud.action.MESH_MEMBER" />
        </intent>
    </queries>

    <!-- #741 /api/net/dns reads the default network's DNS servers and Private
         DNS state (ConnectivityManager.getLinkProperties). A normal permission,
         granted at install; without it every app answered that route blind. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <provider
            android:name="com.diegonmarcos.superapp.devtools.DebugInitProvider"
            android:authorities="${applicationId}.devtools.debuginit"
            android:exported="false"
            android:initOrder="100" />

        <!-- The mesh handshake. Exported so siblings can reach it, gated on the
             CONSTELLATION_DATA permission that libs:core already declares
             signature-level for the AIDL engines — fleet membership is one
             concept, so it gets one permission. core depends on devtools, so
             the declaration always merges in above us. -->
        <provider
            android:name="com.diegonmarcos.superapp.devtools.FleetTokenProvider"
            android:authorities="${applicationId}.fleet"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />

        <!-- #733 the visibility marker the <queries> intent above matches. It
             must be EXPORTED — package-visibility matching skips non-exported
             components — and it is guarded by the same signature permission as
             the provider, so only a fleet member can ever deliver to it. It
             does nothing on receipt: it exists to be matched, not called. -->
        <receiver
            android:name="com.diegonmarcos.superapp.devtools.FleetMemberReceiver"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA">
            <intent-filter>
                <action android:name="com.diegonmarcos.cloud.action.MESH_MEMBER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
