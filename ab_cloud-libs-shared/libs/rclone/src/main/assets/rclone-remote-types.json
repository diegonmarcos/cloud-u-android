{
  "_doc": "The remote types the Remotes tab can create, as DATA: rclone's own backend names and the keys each needs. `fields` are shown as inputs in order; a field with secret=true is passed through `rclone obscure` before it is written, exactly as `rclone config` does, and never echoed back. Anything rclone accepts beyond these can still be typed into the free-form extra options box. Adding a backend is adding an entry here.",
  "types": [
    { "type": "sftp", "label": "SFTP (ssh)", "fields": [
      { "key": "host", "label": "Host", "required": true }, { "key": "user", "label": "User", "required": true },
      { "key": "port", "label": "Port", "default": "22" }, { "key": "pass", "label": "Password", "secret": true },
      { "key": "key_file", "label": "Private key file (instead of password)" } ] },
    { "type": "webdav", "label": "WebDAV", "fields": [
      { "key": "url", "label": "URL", "required": true }, { "key": "vendor", "label": "Vendor (nextcloud, owncloud, other)", "default": "other" },
      { "key": "user", "label": "User" }, { "key": "pass", "label": "Password", "secret": true } ] },
    { "type": "ftp", "label": "FTP", "fields": [
      { "key": "host", "label": "Host", "required": true }, { "key": "user", "label": "User", "default": "anonymous" },
      { "key": "port", "label": "Port", "default": "21" }, { "key": "pass", "label": "Password", "secret": true },
      { "key": "explicit_tls", "label": "Explicit TLS (true/false)", "default": "false" } ] },
    { "type": "s3", "label": "S3 (AWS, MinIO, Backblaze S3, …)", "fields": [
      { "key": "provider", "label": "Provider (AWS, Minio, Other …)", "default": "Other" }, { "key": "endpoint", "label": "Endpoint URL" },
      { "key": "access_key_id", "label": "Access key id", "required": true }, { "key": "secret_access_key", "label": "Secret access key", "required": true },
      { "key": "region", "label": "Region" } ] },
    { "type": "b2", "label": "Backblaze B2", "fields": [
      { "key": "account", "label": "Account id / key id", "required": true }, { "key": "key", "label": "Application key", "required": true } ] },
    { "type": "drive", "label": "Google Drive (token from another rclone)", "fields": [
      { "key": "token", "label": "Token JSON (from `rclone config` elsewhere)", "required": true }, { "key": "scope", "label": "Scope", "default": "drive" } ] },
    { "type": "smb", "label": "SMB / CIFS", "fields": [
      { "key": "host", "label": "Host", "required": true }, { "key": "user", "label": "User" },
      { "key": "pass", "label": "Password", "secret": true }, { "key": "domain", "label": "Domain", "default": "WORKGROUP" } ] },
    { "type": "local", "label": "Local folder", "fields": [] },
    { "type": "crypt", "label": "Crypt (over another remote)", "fields": [
      { "key": "remote", "label": "Underlying remote:path", "required": true }, { "key": "password", "label": "Password", "secret": true, "required": true },
      { "key": "password2", "label": "Salt (optional)", "secret": true } ] }
  ]
}
