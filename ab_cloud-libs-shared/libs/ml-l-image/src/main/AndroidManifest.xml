<?xml version="1.0" encoding="utf-8"?>
<!-- libs:ml-l-image — the contract half of the image scan. No components: the engine's
     service lives in Cloud-Lib-Ml-L-Image-Mlkit.apk. This query merges into every consumer,
     so the engine is visible to each of them on Android 11+ (engine-client.json). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="${imageEnginePackage}" />
    </queries>
</manifest>
