<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Install other APKs via PackageInstaller (user prompt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Declared HERE, not per app: every consumer of libs:updater installs
         fleet APKs, so every one of them needs this or its updates prompt.
         ac_cloud-ide was the app that proved the point - it uses the updater
         and was the only fleet app missing the permission. Manifest merge now
         gives it to all of them, and a new consumer cannot forget. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Foreground notification for download progress. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- #903 a running batch holds a dataSync foreground service (BatchForegroundService);
         declared HERE so every consumer that runs UpdateWorker / ApkInstallWorker has it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <service
            android:name="com.diegonmarcos.superapp.updater.BatchForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- #903 WorkManager runs UpdateWorker / ApkInstallWorker's ForegroundInfo(dataSync) in
             ITS service: Android 14 refuses a type the manifest does not declare
             ("foregroundServiceType 0x1 is not a subset of ... 0x0", seen in cloud-nav's
             instrumented run). Declared HERE, once, so every app that links this lib and
             runs its workers carries it — not only the two Store hosts. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />
        <!-- Reused for PackageInstaller callback. -->
        <receiver
            android:name=".PackageInstallerReceiver"
            android:exported="false" />

        <!-- BootstrapInstall's zero-privilege install path: hands a content://
             URI for a VERIFIED APK to the system package installer, which is
             the only channel that survives losing every privileged one.

             Declared HERE, not per app, for the same reason as
             UPDATE_PACKAGES_WITHOUT_USER_ACTION above — and additionally
             because the authority MUST be unique across the constellation.
             Every app shares the com.diegonmarcos.* prefix, and two installed
             packages declaring the same provider authority makes the second
             one refuse to install at all. ${applicationId} is unique by
             construction; a hand-written suffix per app is not.

             The android:name is a NAMED SUBCLASS for the same reason the
             authority is suffixed: a component name must be unique inside a
             package too. Naming androidx's FileProvider directly collided with
             the one cloud-mail declares for its attachments the moment that app
             took this module, and neither provider can be given up. See
             UpdaterFileProvider. -->
        <provider
            android:name="com.diegonmarcos.superapp.updater.UpdaterFileProvider"
            android:authorities="${applicationId}.updater.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/updater_apk_paths" />
        </provider>
    </application>
</manifest>
