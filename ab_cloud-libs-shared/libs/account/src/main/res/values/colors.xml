<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── Status light (Configs ▸ Panel ▸ Control, Permissions, Profile) ──
         The app's ONE definition of healthy / failed / cannot-say. They are
         resources and not Kotlin constants so a theme can override them: this
         app paints its pages over a black→deep-purple gradient by default and
         over PURE BLACK under the two oled_black launcher themes, and a status
         light is the last thing on screen that may become hard to read.

         Chosen against BOTH of those surfaces, not against white. The values
         these replaced (#16A34A / #DC2626 / #6B7280) were picked for a light
         background and measured 4.35:1 and 2.95:1 for the red on black and on
         the purple band — below the 4.5:1 AA floor for the 12sp text they are
         drawn as. test-configs-panel-control.sh recomputes every ratio rather
         than trusting this comment. -->
    <color name="status_light_on">#FF3DDC84</color>       <!-- 11.77:1 black, 7.99:1 purple -->
    <color name="status_light_off">#FFF87171</color>      <!--  7.59:1 black, 5.16:1 purple -->
    <color name="status_light_unknown">#FFB0B8C4</color>  <!-- 10.50:1 black, 7.13:1 purple -->
</resources>
