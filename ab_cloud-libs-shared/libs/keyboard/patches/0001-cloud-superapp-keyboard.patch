+
+    fun appendCodePoint(cp: Int) { buffer.appendCodePoint(cp); onChanged() }
+    fun backspace() {
+        if (buffer.isNotEmpty()) {
+            val last = buffer.length - 1
+            if (last > 0 && Character.isLowSurrogate(buffer[last]) && Character.isHighSurrogate(buffer[last - 1]))
