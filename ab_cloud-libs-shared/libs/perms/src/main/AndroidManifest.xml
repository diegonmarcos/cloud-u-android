<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- #1274 the Permissions page every app that embeds libs:perms hosts, merged in by the manifest merger.
             Android permissions belong to one package, so an app's banner must open ITS OWN page (a deep link to
             SuperApp would grant SuperApp, not this app). SuperApp hosts its fuller page through PermsHost instead. -->
        <activity
            android:name=".PermsActivity"
            android:exported="false"
            android:label="Permissions"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- #1360 this app's own grants (build.json::perms.needs), read by the fleet apps it does work for (Cloud Drive and
             Cloud Notes read cld.termux's All files access here). Read-only; only constellation apps (libs:core's
             signature permission) can read it. Its onCreate also installs the first-run ask (PermsFirstRun). -->
        <provider
            android:name=".PermsStateProvider"
            android:authorities="${applicationId}.perms"
            android:exported="true"
            android:readPermission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
    </application>
</manifest>
