    {"id": "camera", "label": "Camera", "why": "Takes photos, scans codes and documents.", "icon": "camera", "group": "CAMERA", "kind": "runtime", "section": "runtime", "permission": "android.permission.CAMERA", "adb": ["pm grant {pkg} android.permission.CAMERA"], "features": ["camera", "qr", "browser"]},
