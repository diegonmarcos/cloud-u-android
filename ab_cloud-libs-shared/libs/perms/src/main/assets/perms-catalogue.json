    {"id": "body_sensors", "label": "Body sensors", "group": "SENSORS", "kind": "runtime", "section": "runtime", "permission": "android.permission.BODY_SENSORS", "adb": ["pm grant {pkg} android.permission.BODY_SENSORS"], "features": ["health"]},

    {"id": "all_files", "label": "All files access", "group": "STORAGE", "kind": "special", "section": "special", "permission": "android.permission.MANAGE_EXTERNAL_STORAGE", "check": "all_files", "min_sdk": 30, "settings": {"action": "android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION", "package_uri": true, "fallbacks": ["android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION"]}, "look_for": "Allow access to manage all files", "instruction": "Turn the switch on.", "adb": ["appops set {pkg} MANAGE_EXTERNAL_STORAGE allow"], "features": ["mounts", "drive", "app"]},
    {"id": "overlay", "label": "Display over other apps", "group": "DISPLAY", "kind": "special", "section": "special", "permission": "android.permission.SYSTEM_ALERT_WINDOW", "check": "overlay", "settings": {"action": "android.settings.action.MANAGE_OVERLAY_PERMISSION", "package_uri": true}, "look_for": "Allow display over other apps", "instruction": "Turn the switch on.", "adb": ["appops set {pkg} SYSTEM_ALERT_WINDOW allow"], "features": ["floating-nav", "app"]},
    {"id": "write_settings", "label": "Modify system settings", "group": "SETTINGS", "kind": "special", "section": "special", "permission": "android.permission.WRITE_SETTINGS", "check": "write_settings", "settings": {"action": "android.settings.action.MANAGE_WRITE_SETTINGS", "package_uri": true}, "look_for": "Allow modifying system settings", "instruction": "Turn the switch on.", "adb": ["appops set {pkg} WRITE_SETTINGS allow"], "features": ["light", "controls"]},
    {"id": "install_unknown", "label": "Install unknown apps", "group": "PACKAGES", "kind": "special", "section": "special", "permission": "android.permission.REQUEST_INSTALL_PACKAGES", "check": "install_unknown", "settings": {"action": "android.settings.MANAGE_UNKNOWN_APP_SOURCES", "package_uri": true}, "look_for": "Allow from this source", "instruction": "Turn the switch on.", "adb": ["appops set {pkg} REQUEST_INSTALL_PACKAGES allow"], "features": ["updater", "appstore"]},
