    {"id": "accessibility", "label": "Accessibility service", "group": "ACCESSIBILITY", "kind": "special", "section": "special", "check": "accessibility", "settings": {"action": "android.settings.ACCESSIBILITY_SETTINGS", "highlight_key": "{a11y}"}, "look_for": "Installed apps > Cloud SuperApp > Use", "instruction": "Open the service and turn Use on (allow restricted settings first if greyed).", "adb": ["v=$(settings get secure enabled_accessibility_services); case \"$v\" in *{a11y}*) ;; null|'') v={a11y} ;; *) v=$v:{a11y} ;; esac; settings put secure enabled_accessibility_services $v; settings put secure accessibility_enabled 1"], "features": ["lockscreen", "gesture"]},
