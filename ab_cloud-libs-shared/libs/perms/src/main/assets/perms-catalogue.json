    {"id": "health_connect", "label": "Health Connect", "why": "Reads and writes your health data.", "icon": "heart", "group": "SENSORS", "kind": "special", "section": "special", "check": "health_connect", "min_sdk": 28, "settings": {"action": "android.health.connect.action.MANAGE_HEALTH_PERMISSIONS", "fallbacks": ["androidx.health.ACTION_HEALTH_CONNECT_SETTINGS", "android.health.connect.action.HEALTH_HOME_SETTINGS"]}, "look_for": "Health Connect > App permissions > this app > Allow all", "instruction": "Turn on every data type the app reads (#1360: Cloud Me, Cloud Nav steps).", "adb": [], "features": ["health"]},
    {"id": "all_files", "label": "All files access", "why": "Reads and writes every file in shared storage.", "icon": "folder", "group": "STORAGE", "kind": "special", "section": "special", "permission": "android.permission.MANAGE_EXTERNAL_STORAGE", "check": "all_files", "min_sdk": 30, "settings": {"action": "android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION", "package_uri": true, "fallbacks": ["android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION"]}, "look_for": "Allow access to manage all files", "instruction": "Turn the switch on.", "adb": ["appops set {pkg} MANAGE_EXTERNAL_STORAGE allow"], "features": ["mounts", "drive", "app", "keyboard"]},
