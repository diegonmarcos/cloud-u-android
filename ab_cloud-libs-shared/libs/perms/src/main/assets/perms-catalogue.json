    {"id": "contacts_read", "label": "Contacts (read)", "why": "Reads your contacts to show and sync them.", "icon": "person", "group": "CONTACTS", "kind": "runtime", "section": "runtime", "permission": "android.permission.READ_CONTACTS", "adb": ["pm grant {pkg} android.permission.READ_CONTACTS"], "features": ["contacts", "kde-connect", "keyboard"]},
