{
  "_doc": "#1274 The permission catalogue read by libs:perms PermCatalogue: the ONE list the Permissions page draws, auto-requests, checks and generates the ADB block from. Feature libs declare what they need through `features` here and PermsNeeds.missing(ctx, feature); they never ask or open settings themselves. kind: runtime (system dialog) | special (a settings toggle) | appops (an app-op) | adb_only (only pm grant / shell can set it). section: runtime | special | battery | samsung | adb (page order). A runtime entry that the app's manifest does not declare reads 'not applicable'. settings.action opens the exact page; package_uri adds package:<pkg>; highlight_key goes in :settings:fragment_args_key (scroll + highlight where Settings supports it); samsung_component is tried first on Samsung. adb: shell commands without the 'adb shell' prefix; {pkg} {listener} {a11y} {admin} are filled per device, a line with an unknown value is dropped.",
  "_doc_contract_libs": "Feature libs held to the contract by PermsOnePlaceTest: none may request a permission or start a permission settings page; each goes through PermsNeeds + PermsLink.",
  "contract_libs": ["wifi", "bluetooth", "nfc", "mounts", "mounts-engine", "light", "battery"],
  "group_order": ["NOTIFICATIONS", "LOCATION", "NEARBY_DEVICES", "CAMERA", "MICROPHONE", "CONTACTS", "CALENDAR", "PHONE", "SMS", "STORAGE", "ACTIVITY", "SENSORS", "LOCATION_BACKGROUND"],
  "entries": [
    {"id": "notifications", "label": "Notifications", "group": "NOTIFICATIONS", "kind": "runtime", "section": "runtime", "permission": "android.permission.POST_NOTIFICATIONS", "min_sdk": 33, "adb": ["pm grant {pkg} android.permission.POST_NOTIFICATIONS"], "features": ["app", "notifications"]},
    {"id": "fine_location", "label": "Precise location", "group": "LOCATION", "kind": "runtime", "section": "runtime", "permission": "android.permission.ACCESS_FINE_LOCATION", "look_for": "Location > Allow only while using the app + Use precise location", "adb": ["pm grant {pkg} android.permission.ACCESS_FINE_LOCATION"], "features": ["wifi", "bluetooth-legacy", "hotspot", "maps"]},
    {"id": "coarse_location", "label": "Approximate location", "group": "LOCATION", "kind": "runtime", "section": "runtime", "permission": "android.permission.ACCESS_COARSE_LOCATION", "adb": ["pm grant {pkg} android.permission.ACCESS_COARSE_LOCATION"], "features": ["wifi", "maps"]},
    {"id": "background_location", "label": "Location all the time", "group": "LOCATION_BACKGROUND", "kind": "runtime", "section": "runtime", "permission": "android.permission.ACCESS_BACKGROUND_LOCATION", "min_sdk": 29, "auto_request": false, "requires": ["fine_location"], "settings": {"action": "android.settings.APPLICATION_DETAILS_SETTINGS", "package_uri": true, "highlight_key": "permission_settings"}, "look_for": "Permissions > Location > Allow all the time", "instruction": "Android only grants this from the app's Location page.", "adb": ["pm grant {pkg} android.permission.ACCESS_BACKGROUND_LOCATION"], "features": ["maps"]},
