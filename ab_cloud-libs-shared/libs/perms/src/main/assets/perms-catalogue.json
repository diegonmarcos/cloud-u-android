    {"id": "usage_access", "label": "Usage access", "group": "USAGE", "kind": "appops", "section": "special", "permission": "android.permission.PACKAGE_USAGE_STATS", "appop": "android:get_usage_stats", "check": "appop", "settings": {"action": "android.settings.USAGE_ACCESS_SETTINGS", "package_uri": true, "fallbacks": ["android.settings.USAGE_ACCESS_SETTINGS"]}, "look_for": "Permit usage access", "instruction": "Pick this app, turn the switch on.", "adb": ["appops set {pkg} GET_USAGE_STATS allow"], "features": ["battery", "recentapps", "datamanager"]},
    {"id": "restricted_settings", "label": "Allow restricted settings", "group": "RESTRICTED", "kind": "appops", "section": "special", "appop": "android:access_restricted_settings", "check": "appop", "min_sdk": 33, "settings": {"action": "android.settings.APPLICATION_DETAILS_SETTINGS", "package_uri": true}, "look_for": "Top-right menu > Allow restricted settings", "instruction": "Needed once before accessibility or notification access can be switched on for a sideloaded app.", "adb": ["appops set {pkg} ACCESS_RESTRICTED_SETTINGS allow"], "features": ["notifications", "lockscreen"]},
