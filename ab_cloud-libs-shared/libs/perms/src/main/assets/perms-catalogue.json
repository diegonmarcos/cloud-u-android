    {"id": "calendar_write", "label": "Calendar (write)", "why": "Adds and edits calendar events.", "icon": "event", "group": "CALENDAR", "kind": "runtime", "section": "runtime", "permission": "android.permission.WRITE_CALENDAR", "adb": ["pm grant {pkg} android.permission.WRITE_CALENDAR"], "features": ["cal"]},
