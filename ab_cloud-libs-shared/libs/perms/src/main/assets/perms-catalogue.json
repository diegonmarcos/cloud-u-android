    {"id": "usage_access", "label": "Usage access", "why": "Reads which apps you use and for how long.", "icon": "insights", "group": "USAGE", "kind": "appops", "section": "special", "permission": "android.permission.PACKAGE_USAGE_STATS", "appop": "android:get_usage_stats", "check": "appop", "settings": {"action": "android.settings.USAGE_ACCESS_SETTINGS", "package_uri": true, "fallbacks": ["android.settings.USAGE_ACCESS_SETTINGS"]}, "look_for": "Permit usage access", "instruction": "Pick this app, turn the switch on.", "adb": ["appops set {pkg} GET_USAGE_STATS allow"], "features": ["battery", "recentapps", "datamanager", "disk", "firewall", "appstore"]},
