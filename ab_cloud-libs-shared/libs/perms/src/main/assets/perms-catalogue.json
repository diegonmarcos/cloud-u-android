  "entries": [
    {"id": "notifications", "label": "Notifications", "why": "Shows progress, reminders and alerts.", "icon": "notifications", "group": "NOTIFICATIONS", "kind": "runtime", "section": "runtime", "permission": "android.permission.POST_NOTIFICATIONS", "min_sdk": 33, "adb": ["pm grant {pkg} android.permission.POST_NOTIFICATIONS"], "features": ["app", "notifications", "maps", "browser"]},
    {"id": "fine_location", "label": "Precise location", "why": "Uses your exact position, for maps and nearby places.", "icon": "location", "group": "LOCATION", "kind": "runtime", "section": "runtime", "permission": "android.permission.ACCESS_FINE_LOCATION", "look_for": "Location > Allow only while using the app + Use precise location", "adb": ["pm grant {pkg} android.permission.ACCESS_FINE_LOCATION"], "features": ["wifi", "bluetooth-legacy", "hotspot", "maps", "browser"]},
    {"id": "coarse_location", "label": "Approximate location", "why": "Uses your rough area, for local results.", "icon": "location", "group": "LOCATION", "kind": "runtime", "section": "runtime", "permission": "android.permission.ACCESS_COARSE_LOCATION", "adb": ["pm grant {pkg} android.permission.ACCESS_COARSE_LOCATION"], "features": ["wifi", "maps", "browser"]},
    {"id": "background_location", "label": "Location all the time", "why": "Keeps using location while the app is closed.", "icon": "location", "group": "LOCATION_BACKGROUND", "kind": "runtime", "section": "runtime", "permission": "android.permission.ACCESS_BACKGROUND_LOCATION", "min_sdk": 29, "auto_request": false, "requires": ["fine_location"], "settings": {"action": "android.settings.APPLICATION_DETAILS_SETTINGS", "package_uri": true, "highlight_key": "permission_settings"}, "look_for": "Permissions > Location > Allow all the time", "instruction": "Android only grants this from the app's Location page.", "adb": ["pm grant {pkg} android.permission.ACCESS_BACKGROUND_LOCATION"], "features": ["maps"]},
    {"id": "nearby_wifi", "label": "Nearby Wi-Fi devices", "why": "Finds Wi-Fi networks and devices around you.", "icon": "wifi", "group": "NEARBY_DEVICES", "kind": "runtime", "section": "runtime", "permission": "android.permission.NEARBY_WIFI_DEVICES", "min_sdk": 33, "adb": ["pm grant {pkg} android.permission.NEARBY_WIFI_DEVICES"], "features": ["wifi", "wifi-direct", "hotspot"]},
    {"id": "bt_scan", "label": "Bluetooth scan", "why": "Finds Bluetooth devices nearby.", "icon": "bluetooth", "group": "NEARBY_DEVICES", "kind": "runtime", "section": "runtime", "permission": "android.permission.BLUETOOTH_SCAN", "min_sdk": 31, "adb": ["pm grant {pkg} android.permission.BLUETOOTH_SCAN"], "features": ["bluetooth", "browser"]},
    {"id": "bt_connect", "label": "Bluetooth connect", "why": "Talks to Bluetooth devices you paired.", "icon": "bluetooth", "group": "NEARBY_DEVICES", "kind": "runtime", "section": "runtime", "permission": "android.permission.BLUETOOTH_CONNECT", "min_sdk": 31, "adb": ["pm grant {pkg} android.permission.BLUETOOTH_CONNECT"], "features": ["bluetooth", "browser"]},
