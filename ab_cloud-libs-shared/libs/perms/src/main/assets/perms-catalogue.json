    {"id": "storage_write", "label": "Storage (write)", "why": "Saves files on older Android versions.", "icon": "folder", "group": "STORAGE", "kind": "runtime", "section": "runtime", "permission": "android.permission.WRITE_EXTERNAL_STORAGE", "max_sdk": 29, "adb": ["pm grant {pkg} android.permission.WRITE_EXTERNAL_STORAGE"], "features": ["mounts"]},
