<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- THE HOST THEME, AND ONLY THE HOST THEME. The screens themselves are Compose and take
         their colours from CloudWriterTheme (ui/Theme.kt), which reads the wallpaper palette on
         Android 12+. What is left for this file is the handful of things that are painted BEFORE
         the first composition: the window background behind the starting window, and the system
         bar colours for the instant before Compose sets them.

         DayNight, which it was not. The window background used to be the literal #0b0e14 in every
         configuration, so a phone in light mode opened this app on a black rectangle and then
         redrew it light — and, more to the point, a dark-only window background is exactly the
         kind of thing that stays dark-only after the rest of the app has learned both modes. The
         value now comes from values/ and values-night/ so there is one place per mode.

         NoActionBar: the Compose screens draw their own LargeTopAppBar, and a platform action bar
         over it would put the application name on screen twice. -->
    <style name="Theme.CloudWriter" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
    </style>
</resources>
