<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Writer — the four Text tools with a screen the owner can open.

  THERE IS DELIBERATELY NO <service> UNDER THE ITextTools ACTION IN HERE, and
  that absence is the most load-bearing thing in this file.

  libs:text-tools resolves the serving app from TextTools.SERVICE_PACKAGES —
  cloud-writer first, cloud-keyboard second — against whoever actually
  publishes that action. The moment this manifest publishes it, EVERY consumer
  on the phone rebinds here at its next rebind: cloud-mail's Enhance and
  Resume, cloud-keyboard's own toolbar key, the SuperApp's Tokens Fleet page.
  All four tools at once, on the first bind, with no consumer commit — that is
  the mechanism working exactly as designed, and it is why publishing the
  action is not a step to take casually.

  This build cannot honour that takeover, for a reason no manifest can fix: the
  owner's provider API key lives in cloud-keyboard's SharedPreferences under
  cloud-keyboard's user id, and no install moves it. A cloud-writer that served
  would answer "No API key" to every consumer until the key was re-entered by
  hand, having first taken those tools away from the peer that could still do
  them. See build.json::_doc_why_not_serve_yet for the second reason (the
  engine is still inside libs:keyboard) and _doc_what_serving_needs for the
  four things that must be true before this becomes a <service>.

  INTERNET is NOT declared, and its absence is also deliberate. This app opens
  no socket of its own: every tool is a binder transaction to the serving app,
  which makes the request in ITS process with ITS credential. A permission
  declared here would be a permission the owner grants for something that never
  happens, and it would be the first sign of an engine quietly growing a second
  home. The permissions this app DOES need — CONSTELLATION_DATA (signature) and
  the action-scoped <queries> grant that makes the serving app resolvable at
  all — are merged in from libs:text-tools' own manifest, so nothing about the
  binder is restated here where the two copies could disagree.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudWriter">
        <activity
            android:name="com.diegonmarcos.cloudwriter.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a text into Cloud Writer from any app. The four tools are
                 useful on text that is already somewhere else, and without this
                 the only way in is to retype or paste by hand. SEND/text-plain
                 only: this app has nothing to do with a file or an image, and
                 claiming a type it cannot open would put a dead entry in every
                 share sheet on the phone. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- PROCESS_TEXT: the "Cloud Writer" entry in the text-selection
                 menu of any app. android:label is what that menu shows, so it
                 is a string resource and translated like every other label. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
