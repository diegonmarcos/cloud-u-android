<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Writer — the four Text tools with a screen the owner can open.

  THERE IS DELIBERATELY NO <service> UNDER THE ITextTools ACTION IN HERE, and
  that absence is the most load-bearing thing in this file.

  libs:text-tools resolves the serving app from TextTools.SERVICE_PACKAGES —
  cloud-writer first, cloud-keyboard second — against whoever actually
  publishes that action. The moment this manifest publishes it, EVERY consumer
  on the phone rebinds here at its next rebind: cloud-mail's Enhance and
  Resume, cloud-keyboard's own toolbar key, the SuperApp's Tokens Fleet page.
  All four tools at once, on the first bind, with no consumer commit — that is
  the mechanism working exactly as designed, and it is why publishing the
  action is not a step to take casually.

  This build cannot honour that takeover, for a reason no manifest can fix: the
  owner's provider API key lives in cloud-keyboard's SharedPreferences under
  cloud-keyboard's user id, and no install moves it. A cloud-writer that served
  would answer "No API key" to every consumer until the key was re-entered by
  hand, having first taken those tools away from the peer that could still do
  them. See build.json::_doc_why_not_serve_yet for the second reason (the
  engine is still inside libs:keyboard) and _doc_what_serving_needs for the
  four things that must be true before this becomes a <service>.

  INTERNET is not declared HERE: libs:devtools declares it (its debug socket)
  and the merged manifest carries it. Since #800 this app does use it, for one
  thing only: the MODEL route of Speech-to-text and Translation (WriterRoutes),
  an OpenRouter request through libs:decisions' transport with the fleet
  Account's token read for that request and dropped. The four text tools still
  never open a socket here: they are binder transactions to the serving app,
  which makes the request in ITS process with ITS credential. The permissions this app DOES need — CONSTELLATION_DATA (signature) and
  the action-scoped <queries> grant that makes the serving app resolvable at
  all — are merged in from libs:text-tools' own manifest, so nothing about the
  binder is restated here where the two copies could disagree.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- #800 LISTEN. The microphone is recorded here and its frames are fed to the on-device
         engine or cut into segments for the speech model; a microphone foreground service keeps
         it recording with the screen off, because Android silences a background AudioRecord.
         POST_NOTIFICATIONS shows that service's notice on 13+. ACCESS_NETWORK_STATE is how the
         model route knows it is offline and falls back to on-device without trying. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The on-device speech engine (Vosk) is IVoiceEngine in the keyboard-engines companion,
         guarded by its signature permission; the package is build.json::writer_routes.voice_engine,
         substituted by app/build.gradle. Without the query it is invisible on Android 11+ and reads
         as "not installed". -->
    <uses-permission android:name="com.diegonmarcos.cloudkeyboardlibs.BIND_ENGINE" />
    <queries>
        <package android:name="${voiceEnginePackage}" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudWriter">
        <activity
            android:name="com.diegonmarcos.cloudwriter.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a text into Cloud Writer from any app. The four tools are
                 useful on text that is already somewhere else, and without this
                 the only way in is to retype or paste by hand. SEND/text-plain
                 only: this app has nothing to do with a file or an image, and
                 claiming a type it cannot open would put a dead entry in every
                 share sheet on the phone. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- PROCESS_TEXT: the "Cloud Writer" entry in the text-selection
                 menu of any app. android:label is what that menu shows, so it
                 is a string resource and translated like every other label. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- THE FOUR CONFIGURATION PAGES.

             Every one of them is an activity OF THIS APPLICATION, drawing THIS
             APPLICATION'S preference file. None of them is an alias, a trampoline
             or an <activity-alias> onto Cloud Keyboard's settings, and nothing in
             this manifest declares an <intent-filter> that would let the keyboard
             hand a page back to us or us to it. That is the whole point: the owner
             asked for the same pages, editable here, and "the same page" reached
             by starting the other app's activity is exactly what task 209 shipped.

             android:exported="false" on all four. They are opened by MainActivity
             and by nothing else; there is no reason for another app on the phone
             to be able to start Cloud Writer's settings, and an exported settings
             screen is a way for something else to drive them.

             NO <service> IS ADDED HERE EITHER. The comment at the top of this file
             still holds in full: publishing the ITextTools action would take every
             consumer's Enhance, Summary, Translate and Grammar at once, and this
             build still cannot honour it. Adding four pages does not change that
             and must not be read as a step towards it. -->
        <activity android:name="com.diegonmarcos.cloudwriter.TextEnhanceActivity"
            android:exported="false"
            android:label="@string/settings_screen_enhance"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.diegonmarcos.cloudwriter.TranslationActivity"
            android:exported="false"
            android:label="@string/settings_screen_translation"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <activity android:name="com.diegonmarcos.cloudwriter.GrammarCheckActivity"
            android:exported="false"
            android:label="@string/settings_screen_grammar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <activity android:name="com.diegonmarcos.cloudwriter.AiRoutingActivity"
            android:exported="false"
            android:label="@string/settings_screen_ai_routing"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- #800 PAGE 5, Routes: Model vs On-device for speech and translation. -->
        <activity android:name="com.diegonmarcos.cloudwriter.RoutesActivity"
            android:exported="false"
            android:label="@string/settings_screen_routes"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- #800 Listen with the screen off. Not exported: only this app starts or stops it. -->
        <service android:name="com.diegonmarcos.cloudwriter.ListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- #800 Registers /api/writer/* on the fleet debug server. Not exported, not a real provider. -->
        <provider
            android:name="com.diegonmarcos.cloudwriter.WriterDebugApiProvider"
            android:authorities="${applicationId}.writerdebugapi"
            android:exported="false" />
    </application>
</manifest>
