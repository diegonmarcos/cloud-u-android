<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET, and it must be declared HERE.
         This app is nothing but a network read: every number on its one screen
         comes from api.github.com. A standalone app wrapper that forgets to
         re-declare this gets an empty list and no error worth reading — the
         trap ac_cloud-keyboard already walked into once and ac_c3-morpheus
         records. ACCESS_NETWORK_STATE so "no network" and "GitHub said no" can
         be told apart on screen instead of both rendering as zero. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatchTower">
        <activity
            android:name="com.diegonmarcos.watchtower.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
