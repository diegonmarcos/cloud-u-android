<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- #867 Cloud Account: the Account page as its own APK. INTERNET (sign-in,
         vault fetch, profile sync) and the install engine's permissions come
         through the manifest merge from libs:account's dependencies. What the
         Fleet tab reads on top is declared here. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Fleet tab reads the installed version of every constellation package. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Account redesign (spec 2.4): Account's OWN uid-2000 channel, as Cloud Store has it (#894).
         mDNS discovery of the phone's Wireless debugging, the pairing service held in the
         foreground while the code is typed into its notification, the re-arm after a reboot, and
         WRITE_SECURE_SETTINGS (granted to itself over the channel after the first connect) so
         adb_wifi_enabled can be turned back on at boot without the user. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Account ▸ Import sends each ID document it finds to Cloud Vault's add-identity entry point
         (autofill/VaultIdentityHandoff.kt), which opens the vault's new-Identity screen prefilled.
         A fleet signature permission: granted at install because both apps carry the constellation
         key. Defined here too, identically to Cloud Vault's own definition, so it exists whichever
         app is installed first. -->
    <permission
        android:name="com.diegonmarcos.cloud.permission.VAULT_ADD_IDENTITY"
        android:label="Add an ID document to Cloud Vault"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.diegonmarcos.cloud.permission.VAULT_ADD_IDENTITY" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudAccount"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- SuperApp opens the page: com.diegonmarcos.cloudaccount.OPEN. -->
            <intent-filter>
                <action android:name="com.diegonmarcos.cloudaccount.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Account redesign (spec 2.4): the embedded adb pairing flow (the lib declares it too;
             stated here so the app's guard can see it) and the boot re-arm of the channel. -->
        <service
            android:name="com.diegonmarcos.superapp.adbdebug.AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pairs this app's embedded adb client with the phone's own Wireless debugging while the user types the pairing code into the notification" />
        </service>
        <!-- HostShellService (libs:shizuku-adb-debug-tools): holds the process up so the embedded adb
             channel and the fleet debug server (both process state) survive in the background. -->
        <service
            android:name="com.diegonmarcos.superapp.adbdebug.HostShellService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps this app's on-device shell channel and its loopback debug server running between uses" />
        </service>
        <receiver
            android:name="com.diegonmarcos.superapp.adbdebug.HostShellBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- The declared fallback provider (build.json::shizuku_client): the stock Shizuku app
             hands its binder over this provider. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- #867 The data Cloud Account owns (imported configs, profile, S/R/L files), read by
             SuperApp's one-shot copy. CONSTELLATION_DATA is the fleet's signature permission:
             only an APK signed with the fleet key gets in, and the provider re-checks the caller
             (call() is not permission-checked by the framework). Read-only. -->
        <provider
            android:name="com.diegonmarcos.superapp.profile.AccountData$Provider"
            android:authorities="${applicationId}.accountdata"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />

        <!-- The non-secret autofill Source of Truth (a0_docs/eng-specs/autofill-3-tier.md): profiles,
             per-site mapping rules and snippets, read by Cloud Browser (DOM autofill) and Cloud Keyboard
             (candidates). AUTOFILL_PROFILE_READ / _WRITE are signature permissions libs:autofill defines;
             the provider re-checks them, and lets only this app update or delete. Never secrets. -->
        <provider
            android:name=".autofill.AutofillSotProvider"
            android:authorities="com.diegonmarcos.cloudaccount.autofill"
            android:exported="true"
            android:readPermission="com.diegonmarcos.cloud.permission.AUTOFILL_PROFILE_READ"
            android:writePermission="com.diegonmarcos.cloud.permission.AUTOFILL_PROFILE_WRITE" />
    </application>
</manifest>
