  "roles": {
    "Routing / Drafting": {
      "icon": "route",
      "purpose": "Fast first-pass work: pick the right handler for a request and draft short replies for a bigger model to polish."
    },
    "Safety / Guardrails": {
      "icon": "security",
      "purpose": "Screens prompts and answers against a safety policy before or after the main model runs."
    },
    "Code / Math (Edge)": {
      "icon": "code",
      "purpose": "Small-footprint code completion, snippets and arithmetic where a large model is overkill."
    },
    "Deep Reasoning": {
      "icon": "psychology",
      "purpose": "Step-by-step reasoning distilled from a larger model: puzzles, maths and multi-step logic."
    },
    "Lightweight Editing": {
      "icon": "edit",
      "purpose": "Quick rewrites, tone changes and grammar fixes on short text."
    },
    "Tool Calling": {
      "icon": "build",
      "purpose": "Emits well-formed function calls and JSON arguments so an agent can drive tools."
    },
    "Classification / Extract": {
      "icon": "miscellaneous_services",
      "purpose": "Labels text, pulls out fields, entities and dates, and answers short factual lookups."
    },
    "Vision (VLM)": {
      "icon": "visibility",
      "purpose": "Reads images together with text: describe, OCR, answer questions about a picture."
    },
    "Quality Evaluation": {
      "icon": "verified_user",
      "purpose": "Acts as a judge: scores and critiques another model's answers against a rubric."
    },
    "Code / Data Formatting": {
      "icon": "terminal",
      "purpose": "Writes and repairs code, JSON, CSV and structured output at workstation scale."
    },
    "Long-Form Generation": {
      "icon": "description",
      "purpose": "Fluent long answers, articles and summaries with good instruction following."
    },
    "Dense Text Embedding": {
      "icon": "storage",
      "purpose": "Turns text into vectors for semantic search; not a chat model."
    },
    "Multi-Vector Embedding": {
      "icon": "layers",
      "purpose": "Dense plus sparse (lexical) vectors for hybrid, multilingual search; not a chat model."
    },
    "Semantic Reranking": {
      "icon": "compare_arrows",
      "purpose": "Re-scores retrieved passages against the query so the best chunks come first; not a chat model."
    },
    "Code & Tech Retrieval": {
      "icon": "code",
      "purpose": "Embeds code and technical documentation for repository search; not a chat model."
    }
  },
  "quant_guidance": {
    "small": "Q8 keeps near-fp16 quality at half the RAM; Q4 is the sweet spot for a phone. Below 1B stay at Q8, the quality loss at Q4 is noticeable.",
    "medium": "Q4 is the default for a workstation or a 16 GB laptop; use Q8 when the model must be exact (code, judging). fp16 only when there is RAM to spare."
  },
