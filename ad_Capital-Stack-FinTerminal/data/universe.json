{
 "_doc": "The FinTerm market universe the container (capital-stack-finterminal-api) keeps in SQLite and serves under /v1: daily EOD history for every symbol the APK tables read, the government yield matrix (country x tenor), GDP weights and the SEC earnings universe. The container generates its jobs from this file (gen-fetchers.mjs embeds it in fetchers.json, drift-guarded). An etf_proxy row is the listed ETF named in proxy_for, never the index level. A cell with no free source is served as null.",
 "sources": {
  "cboe": {
   "ref": "cboe",
   "format": "cboe_chart",
   "path": "/charts/historical/{code}.json",
   "per_min": 4
  },
  "fred": {
   "ref": "fred",
   "format": "fred_csv",
   "path": "",
   "params": {
    "id": "{code}",
    "cosd": "{from}"
   },
   "per_min": 20
  },
  "coinbase": {
   "ref": "coinbase",
   "format": "coinbase_candles",
   "path": "/products/{code}/candles",
   "params": {
    "granularity": "86400",
    "start": "{page_start}",
    "end": "{page_end}"
   },
   "per_min": 30,
   "page_days": 300,
   "first": "2015-07-20"
  },
  "ecb_data": {
   "ref": "ecb_data",
   "per_min": 20
  },
  "dbnomics": {
   "ref": "dbnomics",
   "per_min": 20
  },
  "worldbank": {
   "ref": "worldbank",
   "per_min": 20
  },
  "frankfurter": {
   "ref": "frankfurter",
   "per_min": 20
  },
  "sec_edgar": {
   "ref": "sec_edgar",
   "per_min": 60
  },
  "bundesbank": {
   "name": "Deutsche Bundesbank time series API",
   "endpoint": "https://api.statistiken.bundesbank.de/rest/data",
   "auth": "none",
   "per_min": 20,
   "licence": "Bundesbank, attribution"
  },
  "boe": {
   "name": "Bank of England Interactive Database",
   "endpoint": "https://www.bankofengland.co.uk",
   "auth": "none",
   "per_min": 10,
   "licence": "Bank of England, attribution"
  },
  "mof_jgb": {
   "name": "Ministry of Finance Japan, JGB interest rates",
   "endpoint": "https://www.mof.go.jp",
   "auth": "none",
   "per_min": 10,
   "licence": "MoF Japan, attribution"
  },
  "boc": {
   "name": "Bank of Canada Valet API",
   "endpoint": "https://www.bankofcanada.ca",
   "auth": "none",
   "per_min": 20,
   "licence": "Bank of Canada terms, attribution"
  },
  "rba": {
   "name": "Reserve Bank of Australia statistical tables",
   "endpoint": "https://www.rba.gov.au",
   "auth": "none",
   "per_min": 10,
   "licence": "RBA, CC BY 4.0"
  },
  "snb": {
   "name": "Swiss National Bank data portal",
   "endpoint": "https://data.snb.ch",
   "auth": "none",
   "per_min": 10,
   "licence": "SNB, attribution"
  }
 },
 "history": {
  "_doc": "The symbols are DERIVED by gen-fetchers.mjs from every dashboards.json panel whose fetch.primary.api is the store route (/v1/history), with the panel's labels; resolve overrides a symbol, else the panel's symbol_map names the Cboe code (an ETF other than the symbol is an etf_proxy), else a plain US ticker is read from Cboe and a Coinbase pair from Coinbase. A symbol none of these covers must be declared unavailable with its reason (the generator fails otherwise). extra adds symbols no table reads yet.",
  "route": "/v1/history",
  "years": 12,
  "daily_every_s": 86400,
  "overlap_days": 10,
  "resolve": {
   "^NDX": {
    "source": "fred",
    "code": "NASDAQ100",
    "kind": "index",
    "note": "index level (FRED, from Nasdaq)"
   },
   "^DJI": {
    "source": "fred",
    "code": "DJIA",
    "kind": "index",
    "note": "index level (FRED, from S&P Dow Jones; FRED keeps 10 years)"
   },
   "^N225": {
    "source": "fred",
    "code": "NIKKEI225",
    "kind": "index",
    "note": "index level (FRED, from Nikkei)"
   },
   "^RUT": {
    "source": "cboe",
    "code": "IWM",
    "kind": "etf_proxy",
    "proxy": "IWM",
    "note": "Cboe publishes no Russell 2000 index history; iShares Russell 2000 ETF"
   },
   "HO=F": {
    "source": "fred",
    "code": "DHOILNYH",
    "kind": "spot",
    "note": "New York Harbor No. 2 heating oil spot (EIA via FRED), not the futures"
   },
   "EMBOND:BR": {
    "source": "computed",
    "kind": "computed",
    "country": "BR",
    "note": "monthly unhedged USD total-return index of the 10-year local government bond (em_bonds.method), 100 at the first month"
   },
   "EMBOND:MX": {
